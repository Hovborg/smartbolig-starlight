---
/**
 * Custom 404 page for SmartBolig.net
 *
 * Lives in src/pages/ so Astro emits dist/404.html, which Cloudflare Pages
 * serves automatically for unknown paths. (A Starlight `components.NotFound`
 * override is NOT a valid Starlight option: that approach silently does
 * nothing, which is why this is a standalone page instead.)
 *
 * Concept: the page renders as a Home Assistant more-info dialog whose entity is
 * `unavailable`, logbook and joke restart button included. The visitor's broken
 * path is an entity attribute, and a build-time index of every real page drives
 * the "Mente du?" suggestions.
 *
 * Parts: src/components/not-found/, copy: src/lib/not-found-copy.ts,
 * browser logic: src/scripts/not-found/.
 */
import { notFoundCopy } from "../lib/not-found-copy";
import { buildPageIndex } from "../lib/not-found-index";
import { scriptJson } from "../lib/script-json";
import NotFoundLayout from "../components/not-found/NotFoundLayout.astro";
import NotFoundIntro from "../components/not-found/NotFoundIntro.astro";
import EntityCard from "../components/not-found/EntityCard.astro";
import Suggestions from "../components/not-found/Suggestions.astro";
import ActionLinks from "../components/not-found/ActionLinks.astro";
import PopularLinks from "../components/not-found/PopularLinks.astro";
import LangSwitch from "../components/not-found/LangSwitch.astro";

// This page is built ONCE as static dist/404.html, so Astro.url.pathname is
// always "/404" at build time: URL-based language detection can never see
// "/en/". Danish is therefore the build-time default, and the browser script
// swaps the copy to English at runtime.
const lang = "da";
const t = notFoundCopy[lang];
const pageIndexJson = scriptJson(await buildPageIndex());
---

<NotFoundLayout lang={lang} t={t}>
  <main class="wrap">
    <NotFoundIntro t={t} />
    <EntityCard t={t} />
    <Suggestions t={t} />
    <ActionLinks t={t} />
    <PopularLinks t={t} />
    <LangSwitch t={t} />
  </main>

  <script type="application/json" id="nf-page-index" set:html={pageIndexJson} />
  <script>
    import "../scripts/not-found/index";
  </script>
</NotFoundLayout>

<style>
  .wrap {
    width: 100%;
    max-width: 46rem;
  }
</style>
