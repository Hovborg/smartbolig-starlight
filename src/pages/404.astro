---
/**
 * Custom 404 page for SmartBolig.net
 *
 * Lives in src/pages/ so Astro emits dist/404.html, which Cloudflare Pages
 * serves automatically for unknown paths. (A Starlight `components.NotFound`
 * override is NOT a valid Starlight option — that approach silently does
 * nothing, which is why this is a standalone page instead.)
 *
 * Concept: the page renders as a Home Assistant more-info dialog whose entity is
 * `unavailable`, logbook and joke restart button included. The visitor's broken
 * path is an entity attribute, and a build-time index of every real page drives
 * the "Mente du?" suggestions.
 *
 * Danish and English are written separately, not translated: the jokes only land
 * if each language gets its own phrasing.
 */
import { getCollection } from 'astro:content';

// This page is built ONCE as static dist/404.html, so Astro.url.pathname is
// always "/404" at build time — URL-based language detection can never see
// "/en/". Danish is therefore the build-time default, and the inline script
// at the bottom swaps the copy to English at runtime.
const lang = 'da';

/**
 * Build-time index of every real page, used client-side to suggest the closest
 * match to the broken URL. Dated AI-news archive entries are excluded: there are
 * ~124 of them and "did you mean 2026-03-11?" is never a useful answer.
 */
const datedAiNews = /(^|\/)ai\/nyheder\/\d{4}-\d{2}-\d{2}$/;
const pageIndex = (await getCollection('docs'))
  .map((entry) => {
    // docsLoader ids are extension-less slugs ("da/home-assistant/zigbee2mqtt").
    // Index files may arrive either as "da/home-assistant" or ".../index".
    const slug = entry.id.replace(/\/index$/, '');
    return { slug, title: entry.data.title };
  })
  .filter(({ slug, title }) => slug && title && !datedAiNews.test(slug))
  .map(({ slug, title }) => ({ p: `/${slug}/`, t: title }))
  .sort((a, b) => a.p.localeCompare(b.p));

const content = {
  da: {
    title: '404 - Side ikke fundet',
    heading: 'Siden svarer ikke',
    // NB: metaDescription matches what scripts/seo-validate.mjs requires verbatim.
    metaDescription: 'Siden blev ikke fundet. Find SmartBolig.net guides fra forsiden.',
    description: 'Siden findes ikke, er flyttet, eller har mistet forbindelsen ligesom den ene Zigbee-pære der altid falder af. Her er det der rent faktisk svarer.',
    eyebrow: 'Fejl 404 · entity not found',
    entityId: 'sensor.side_du_soegte',
    stateLabel: 'unavailable',
    restartingLabel: 'restarting',
    cardHint: 'Enhed: smartbolig.net · sidst set: aldrig',
    historyLabel: 'Tilstand, sidste 24 timer',
    attrState: 'state',
    attrPath: 'requested_path',
    attrDeviceClass: 'device_class',
    // A real HA attribute: `restored: true` is exactly what you see on an entity
    // that no longer exists but is remembered from a previous run.
    attrRestored: 'restored',
    attrChanged: 'last_changed',
    deviceClassValue: 'skuffelse',
    justNow: 'lige nu',
    logTitle: 'Logbog',
    logLines: [
      'side_du_soegte blev unavailable',
      'automation.find_siden udløst, 0 handlinger kørt',
      'smartbolig.net: prøver igen om aldrig',
    ],
    restartLabel: 'Genstart Home Assistant',
    restartBusy: 'Genstarter',
    restartLines: [
      'Genstart gennemført. Siden findes stadig ikke.',
      'Genstart nr. 2. Stadig ingenting.',
      'Tredje gang er ikke lykkens gang. Prøv et af linkene.',
    ],
    suggestTitle: 'Mente du?',
    homeLink: 'Gå til forsiden',
    startLink: 'Guidebiblioteket',
    haLink: 'Home Assistant',
    espLink: 'ESP32',
    popularTitle: 'Sider der rent faktisk svarer',
    guides: [
      { href: '/da/home-assistant/kom-godt-i-gang/', text: 'Kom godt i gang' },
      { href: '/da/home-assistant/zigbee2mqtt/', text: 'Zigbee2MQTT' },
      { href: '/da/esp32/temperatur-sensor/', text: 'Temperatur sensor' },
      { href: '/da/home-assistant/foerste-automation/', text: 'Din første automation' },
    ],
    langSwitch: { href: '/en/', text: 'English version', flag: '🇬🇧' },
    homePath: '/da/',
    startPath: '/da/start/',
    haPath: '/da/home-assistant/',
    espPath: '/da/esp32/',
  },
  en: {
    title: '404 - Page not found',
    heading: 'This page is not responding',
    metaDescription: 'Page not found. Find SmartBolig.net guides from the homepage.',
    description: 'The page does not exist, it moved, or it dropped off the network like that one Zigbee bulb always does. Here is what actually responds.',
    eyebrow: 'Error 404 · entity not found',
    entityId: 'sensor.page_you_requested',
    stateLabel: 'unavailable',
    restartingLabel: 'restarting',
    cardHint: 'Device: smartbolig.net · last seen: never',
    historyLabel: 'State, last 24 hours',
    attrState: 'state',
    attrPath: 'requested_path',
    attrDeviceClass: 'device_class',
    attrRestored: 'restored',
    attrChanged: 'last_changed',
    deviceClassValue: 'disappointment',
    justNow: 'just now',
    logTitle: 'Logbook',
    logLines: [
      'page_you_requested became unavailable',
      'automation.find_the_page triggered, 0 actions run',
      'smartbolig.net: retrying in never',
    ],
    restartLabel: 'Restart Home Assistant',
    restartBusy: 'Restarting',
    restartLines: [
      'Restart complete. The page still does not exist.',
      'Restart number 2. Still nothing.',
      'Third time is not the charm. Try one of the links.',
    ],
    suggestTitle: 'Did you mean?',
    homeLink: 'Go to homepage',
    startLink: 'Guide library',
    haLink: 'Home Assistant',
    espLink: 'ESP32',
    popularTitle: 'Pages that do respond',
    guides: [
      { href: '/en/home-assistant/kom-godt-i-gang/', text: 'Getting Started' },
      { href: '/en/home-assistant/zigbee2mqtt/', text: 'Zigbee2MQTT' },
      { href: '/en/esp32/temperatur-sensor/', text: 'Temperature Sensor' },
      { href: '/en/home-assistant/foerste-automation/', text: 'First Automation' },
    ],
    langSwitch: { href: '/da/', text: 'Dansk version', flag: '🇩🇰' },
    homePath: '/en/',
    startPath: '/en/start/',
    haPath: '/en/home-assistant/',
    espPath: '/en/esp32/',
  },
};

const t = content[lang];

// A 24-slot state history: available for most of the day, then the drop-out
// that produced this 404. Rendered server-side so the scoped styles apply.
const historySlots = Array.from({ length: 24 }, (_, i) => i >= 21);

// Minimal WebPage schema so the 404 page keeps valid structured data
// (scripts/seo-validate.mjs requires a WebPage JSON-LD on dist/404.html).
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: t.title,
  description: t.metaDescription,
  url: "https://smartbolig.net/404/",
  inLanguage: lang === "en" ? "en-US" : "da-DK",
};
const webPageSchemaJson = JSON.stringify(webPageSchema).replace(/</g, "\\u003c");
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{t.title} | SmartBolig.net</title>
    <meta name="description" content={t.metaDescription}>
    <meta name="robots" content="noindex, nofollow">
    <meta property="og:type" content="website">
    <meta property="og:title" content={`${t.title} | SmartBolig.net`}>
    <meta property="og:description" content={t.metaDescription}>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <script type="application/ld+json" set:html={webPageSchemaJson} />
    <script is:inline>
        // Match the theme the visitor already picked on the rest of the site.
        // Starlight stores it under `starlight-theme`; astro.config.mjs forces
        // dark for first-time visitors, so dark is the fallback here too.
        (function () {
            var theme = 'dark';
            try {
                var stored = localStorage.getItem('starlight-theme');
                if (stored === 'light' || stored === 'dark') {
                    theme = stored;
                } else if (stored === 'auto' && window.matchMedia('(prefers-color-scheme: light)').matches) {
                    theme = 'light';
                }
            } catch (error) {
                // Private mode or blocked storage: keep the dark default.
            }
            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <style>
        :root {
            --bg: #0a0e13;
            --panel: #10161e;
            --panel-2: #0d131a;
            --line: rgba(196, 214, 231, 0.16);
            --line-strong: rgba(103, 232, 249, 0.45);
            --text: #f3f7fa;
            --muted: #a9b8c6;
            --faint: #6d7f8e;
            --cyan: #67e8f9;
            --green: #6ce9a6;
            --warm: #e8b98a;
            --focus: #f8d477;
            --on-accent: #04222a;
            --serif: "Charter", "Bitstream Charter", "Sitka Text", Cambria, Georgia, serif;
            --mono: ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
            --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, sans-serif;
        }

        html[data-theme="light"] {
            --bg: #f4f7f9;
            --panel: #ffffff;
            --panel-2: #eef3f6;
            --line: rgba(23, 33, 43, 0.18);
            --line-strong: rgba(8, 121, 138, 0.55);
            --text: #16212c;
            --muted: #4d6070;
            --faint: #6d7f8e;
            --cyan: #08798a;
            --green: #12734a;
            --warm: #8a5a2b;
            --focus: #8a4b00;
            --on-accent: #ffffff;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { color-scheme: dark; }
        html[data-theme="light"] { color-scheme: light; }

        body {
            margin: 0;
            min-height: 100vh;
            padding: clamp(1.5rem, 5vw, 4rem) 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--sans);
            color: var(--text);
            background-color: var(--bg);
            background-image:
                radial-gradient(ellipse at 10% 0%, rgba(103, 232, 249, 0.10), transparent 45%),
                radial-gradient(ellipse at 92% 100%, rgba(232, 185, 138, 0.08), transparent 42%);
            background-attachment: fixed;
        }

        html[data-theme="light"] body {
            background-image:
                radial-gradient(ellipse at 10% 0%, rgba(8, 121, 138, 0.10), transparent 45%),
                radial-gradient(ellipse at 92% 100%, rgba(138, 90, 43, 0.07), transparent 42%);
        }

        .wrap { width: 100%; max-width: 46rem; }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            margin: 0 0 1rem;
            color: var(--cyan);
            font-family: var(--mono);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }
        .eyebrow .dot {
            width: 0.4rem;
            height: 0.4rem;
            border-radius: 999px;
            background: var(--warm);
            box-shadow: 0 0 0 0.22rem rgba(232, 185, 138, 0.16);
            animation: breathe 2.4s ease-in-out infinite;
        }
        @keyframes breathe {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.35; }
        }

        h1 {
            margin: 0 0 0.75rem;
            font-family: var(--serif);
            font-size: clamp(2.1rem, 6vw, 3.1rem);
            font-weight: 700;
            line-height: 1.08;
            letter-spacing: -0.01em;
        }

        .lede {
            margin: 0 0 2rem;
            max-width: 38rem;
            color: var(--muted);
            font-size: 1.02rem;
            line-height: 1.65;
        }

        /* ===== Home Assistant style entity card ===== */
        .card {
            border: 1px solid var(--line);
            border-radius: 14px;
            background: var(--panel);
            box-shadow: 0 18px 40px -28px rgba(0, 0, 0, 0.9);
            overflow: hidden;
        }

        .card-head {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 1rem 1.15rem;
            border-bottom: 1px solid var(--line);
        }
        .card-icon {
            flex: none;
            display: grid;
            place-items: center;
            width: 2.6rem;
            height: 2.6rem;
            border-radius: 999px;
            border: 1px solid rgba(232, 185, 138, 0.35);
            background: rgba(232, 185, 138, 0.12);
            color: var(--warm);
            transition: color 0.3s ease, border-color 0.3s ease, background 0.3s ease;
        }
        .card-icon svg { width: 1.4rem; height: 1.4rem; }
        .card.is-restarting .card-icon {
            color: var(--cyan);
            border-color: var(--line-strong);
            background: rgba(103, 232, 249, 0.12);
            animation: spin 1.1s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        .card-titles { min-width: 0; }
        .entity-id {
            display: block;
            font-family: var(--mono);
            font-size: 0.95rem;
            font-weight: 600;
            overflow-wrap: anywhere;
        }
        .card-hint {
            display: block;
            margin-top: 0.2rem;
            color: var(--muted);
            font-size: 0.8rem;
        }

        .card-state {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 0.75rem 1rem;
            padding: 1.25rem 1.15rem 0.5rem;
        }
        .state-value {
            font-family: var(--mono);
            font-size: clamp(1.6rem, 5.5vw, 2.3rem);
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--warm);
            text-transform: uppercase;
            transition: color 0.3s ease;
        }
        .card.is-restarting .state-value { color: var(--cyan); }
        .state-code {
            font-family: var(--mono);
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            color: var(--muted);
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 0.25rem 0.6rem;
        }

        .history { padding: 0.35rem 1.15rem 1.1rem; }
        .history-label {
            margin: 0 0 0.5rem;
            color: var(--muted);
            font-family: var(--mono);
            font-size: 0.68rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }
        .history-bar {
            display: flex;
            gap: 2px;
            height: 1.6rem;
        }
        .history-bar span {
            flex: 1;
            border-radius: 2px;
            background: var(--green);
            opacity: 0.55;
        }
        .history-bar span.down {
            background:
                repeating-linear-gradient(
                    135deg,
                    var(--warm) 0 3px,
                    transparent 3px 6px
                ),
                rgba(232, 185, 138, 0.22);
            opacity: 1;
            animation: flicker 1.8s steps(2, end) infinite;
        }
        .card.is-restarting .history-bar span {
            background: var(--cyan);
            opacity: 0.28;
            animation: sweep 1.1s ease-in-out infinite;
        }
        @keyframes flicker {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.55; }
        }
        @keyframes sweep {
            0%, 100% { opacity: 0.18; }
            50% { opacity: 0.6; }
        }

        .attrs {
            margin: 0;
            padding: 0.9rem 1.15rem 1.15rem;
            border-top: 1px solid var(--line);
            background: var(--panel-2);
            display: grid;
            grid-template-columns: minmax(7.5rem, auto) 1fr;
            gap: 0.5rem 1rem;
            font-family: var(--mono);
            font-size: 0.83rem;
        }
        .attrs dt { color: var(--muted); }
        .attrs dd {
            margin: 0;
            overflow-wrap: anywhere;
        }
        .attrs dd.accent { color: var(--cyan); }

        /* ===== Logbook + the restart gag ===== */
        .logbook {
            padding: 0.9rem 1.15rem 1.05rem;
            border-top: 1px solid var(--line);
            background: var(--panel-2);
        }
        .logbook h2 {
            margin: 0 0 0.6rem;
            color: var(--muted);
            font-family: var(--mono);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }
        .log-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            gap: 0.3rem;
            font-family: var(--mono);
            font-size: 0.78rem;
            line-height: 1.5;
        }
        .log-list li { display: flex; gap: 0.7rem; }
        .log-list li[hidden] { display: none; }
        .log-time {
            flex: none;
            color: var(--faint);
            font-variant-numeric: tabular-nums;
        }
        .log-text { color: var(--muted); overflow-wrap: anywhere; }
        .log-list li.fresh .log-text { color: var(--warm); }

        .restart {
            margin-top: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.45rem 0.85rem;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: transparent;
            color: var(--muted);
            font-family: var(--mono);
            font-size: 0.75rem;
            cursor: pointer;
            transition: border-color 0.15s ease, color 0.15s ease;
        }
        .restart:hover:not(:disabled),
        .restart:focus-visible {
            border-color: var(--line-strong);
            color: var(--cyan);
        }
        .restart:disabled { cursor: progress; opacity: 0.7; }
        .restart svg { width: 0.9rem; height: 0.9rem; }
        .card.is-restarting .restart svg { animation: spin 1.1s linear infinite; }

        /* ===== Did you mean ===== */
        .suggest {
            margin-top: 1.5rem;
            border: 1px solid var(--line-strong);
            border-radius: 14px;
            padding: 1.1rem 1.15rem;
            background: var(--panel);
        }
        .suggest[hidden] { display: none; }
        .suggest h2 {
            margin: 0 0 0.7rem;
            font-family: var(--mono);
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--cyan);
        }
        .suggest-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: grid;
            gap: 0.4rem;
        }
        .suggest-list li[hidden] { display: none; }
        .suggest-list a {
            display: flex;
            align-items: baseline;
            gap: 0.6rem;
            padding: 0.55rem 0.7rem;
            border-radius: 8px;
            color: var(--text);
            text-decoration: none;
            transition: background 0.15s ease, color 0.15s ease;
        }
        .suggest-list a::before {
            content: "→";
            color: var(--cyan);
            font-family: var(--mono);
        }
        .suggest-list a:hover,
        .suggest-list a:focus-visible {
            background: rgba(103, 232, 249, 0.1);
            color: var(--cyan);
        }
        .suggest-path {
            margin-left: auto;
            color: var(--muted);
            font-family: var(--mono);
            font-size: 0.75rem;
        }
        /* Narrow screens: the title and the path fight over the same row, so
           stack them under the arrow instead of wrapping both mid-word. */
        @media (max-width: 34rem) {
            .suggest-list a {
                display: grid;
                grid-template-columns: auto 1fr;
                align-items: start;
                row-gap: 0.15rem;
            }
            .suggest-list a::before { grid-row: 1 / span 2; }
            .suggest-path {
                grid-column: 2;
                margin-left: 0;
                overflow-wrap: anywhere;
            }
        }

        /* ===== Actions ===== */
        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.7rem;
            margin-top: 1.75rem;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.7rem 1.2rem;
            border-radius: 8px;
            border: 1px solid transparent;
            font-size: 0.95rem;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        }
        .btn-primary {
            background: var(--cyan);
            color: var(--on-accent);
        }
        .btn-primary:hover,
        .btn-primary:focus-visible { background: var(--green); }
        .btn-ghost {
            border-color: var(--line);
            color: var(--text);
        }
        .btn-ghost:hover,
        .btn-ghost:focus-visible {
            border-color: var(--line-strong);
            color: var(--cyan);
        }

        .popular {
            margin-top: 2.25rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--line);
        }
        .popular h2 {
            margin: 0 0 0.85rem;
            color: var(--muted);
            font-family: var(--mono);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }
        .chips {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        .chips a {
            padding: 0.45rem 0.85rem;
            border: 1px solid var(--line);
            border-radius: 999px;
            color: var(--muted);
            font-size: 0.87rem;
            text-decoration: none;
            transition: border-color 0.15s ease, color 0.15s ease;
        }
        .chips a:hover,
        .chips a:focus-visible {
            border-color: var(--line-strong);
            color: var(--cyan);
        }

        .lang-switch { margin: 1.75rem 0 0; }
        .lang-switch a {
            color: var(--muted);
            font-size: 0.87rem;
            text-decoration: none;
        }
        .lang-switch a:hover,
        .lang-switch a:focus-visible {
            color: var(--cyan);
            text-decoration: underline;
        }

        :focus-visible {
            outline: 2px solid var(--focus);
            outline-offset: 2px;
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.001ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.001ms !important;
            }
        }
    </style>
</head>
<body>
    <main class="wrap">
        <p class="eyebrow"><span class="dot"></span><span id="nf-eyebrow">{t.eyebrow}</span></p>
        <h1 id="nf-heading">{t.heading}</h1>
        <p class="lede" id="nf-description">{t.description}</p>

        <section class="card" id="nf-card" aria-labelledby="nf-entity">
            <header class="card-head">
                <span class="card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 11.4 12 4l9 7.4"></path>
                        <path d="M5.6 10.3V20h12.8v-9.7"></path>
                        <path d="m9.8 13.8 4.4 4.4m0-4.4-4.4 4.4"></path>
                    </svg>
                </span>
                <span class="card-titles">
                    <strong class="entity-id" id="nf-entity">{t.entityId}</strong>
                    <span class="card-hint" id="nf-card-hint">{t.cardHint}</span>
                </span>
            </header>

            <div class="card-state">
                <span class="state-value" id="nf-state">{t.stateLabel}</span>
                <span class="state-code">HTTP 404</span>
            </div>

            <div class="history">
                <p class="history-label" id="nf-history-label">{t.historyLabel}</p>
                <div class="history-bar" role="img" aria-label="Home Assistant state history">
                    {historySlots.map((down) => <span class={down ? 'down' : undefined}></span>)}
                </div>
            </div>

            <dl class="attrs">
                <dt id="nf-attr-state">{t.attrState}</dt>
                <dd id="nf-attr-state-value">{t.stateLabel}</dd>
                <dt id="nf-attr-path">{t.attrPath}</dt>
                <dd class="accent" id="nf-path">/</dd>
                <dt id="nf-attr-device-class">{t.attrDeviceClass}</dt>
                <dd id="nf-device-class">{t.deviceClassValue}</dd>
                <dt id="nf-attr-restored">{t.attrRestored}</dt>
                <dd>true</dd>
                <dt id="nf-attr-changed">{t.attrChanged}</dt>
                <dd id="nf-changed">{t.justNow}</dd>
            </dl>

            <div class="logbook">
                <h2 id="nf-log-title">{t.logTitle}</h2>
                <ol class="log-list" id="nf-log">
                    {t.logLines.map((line) => (
                        <li>
                            <span class="log-time">--:--:--</span>
                            <span class="log-text">{line}</span>
                        </li>
                    ))}
                    {t.restartLines.map(() => (
                        <li hidden class="fresh">
                            <span class="log-time">--:--:--</span>
                            <span class="log-text"></span>
                        </li>
                    ))}
                </ol>
                <button type="button" class="restart" id="nf-restart">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
                        <path d="M21 3v6h-6"></path>
                    </svg>
                    <span id="nf-restart-label">{t.restartLabel}</span>
                </button>
            </div>
        </section>

        <section class="suggest" id="nf-suggest" hidden>
            <h2 id="nf-suggest-title">{t.suggestTitle}</h2>
            <ul class="suggest-list" id="nf-suggest-list">
                <li hidden><a href="/"><span class="suggest-text"></span><span class="suggest-path"></span></a></li>
                <li hidden><a href="/"><span class="suggest-text"></span><span class="suggest-path"></span></a></li>
                <li hidden><a href="/"><span class="suggest-text"></span><span class="suggest-path"></span></a></li>
            </ul>
        </section>

        <nav class="actions">
            <a id="nf-home" class="btn btn-primary" href={t.homePath}>{t.homeLink}</a>
            <a id="nf-start" class="btn btn-ghost" href={t.startPath}>{t.startLink}</a>
            <a id="nf-ha" class="btn btn-ghost" href={t.haPath}>{t.haLink}</a>
            <a id="nf-esp" class="btn btn-ghost" href={t.espPath}>{t.espLink}</a>
        </nav>

        <section class="popular">
            <h2 id="nf-popular-title">{t.popularTitle}</h2>
            <div class="chips" id="nf-popular-links">
                {t.guides.map(guide => (
                    <a href={guide.href}>{guide.text}</a>
                ))}
            </div>
        </section>

        <p class="lang-switch">
            <a id="nf-lang-switch" href={t.langSwitch.href}>{t.langSwitch.flag} {t.langSwitch.text}</a>
        </p>
    </main>

    <script is:inline define:vars={{ i18n: content, pageIndex }}>
        (function () {
            var path = location.pathname;

            function set(id, apply) {
                var el = document.getElementById(id);
                if (el) apply(el);
            }

            // --- 1. Language. dist/404.html is served for every unknown path and
            // is built in Danish, so English is swapped in at runtime. A /da/ or
            // /en/ prefix wins; without one (e.g. /typo/) the browser decides, so
            // an English speaker hitting a bare bad URL still gets English.
            var lang = 'da';
            if (path.indexOf('/en/') === 0) {
                lang = 'en';
            } else if (path.indexOf('/da/') !== 0) {
                var preferred = (navigator.languages && navigator.languages[0]) || navigator.language || '';
                if (preferred && preferred.slice(0, 2).toLowerCase() !== 'da') lang = 'en';
            }
            var t = i18n[lang];

            var relativeTime = lang === 'en'
                ? {
                    seconds: function (n) { return n + ' second' + (n === 1 ? '' : 's') + ' ago'; },
                    minutes: function (n) { return n + ' minute' + (n === 1 ? '' : 's') + ' ago'; },
                }
                : {
                    seconds: function (n) { return 'for ' + n + ' sekund' + (n === 1 ? '' : 'er') + ' siden'; },
                    minutes: function (n) { return 'for ' + n + ' minut' + (n === 1 ? '' : 'ter') + ' siden'; },
                };

            if (lang === 'en') {
                document.documentElement.lang = 'en';
                document.title = t.title + ' | SmartBolig.net';
                set('nf-eyebrow', function (el) { el.textContent = t.eyebrow; });
                set('nf-heading', function (el) { el.textContent = t.heading; });
                set('nf-description', function (el) { el.textContent = t.description; });
                set('nf-entity', function (el) { el.textContent = t.entityId; });
                set('nf-card-hint', function (el) { el.textContent = t.cardHint; });
                set('nf-state', function (el) { el.textContent = t.stateLabel; });
                set('nf-history-label', function (el) { el.textContent = t.historyLabel; });
                set('nf-attr-state-value', function (el) { el.textContent = t.stateLabel; });
                set('nf-device-class', function (el) { el.textContent = t.deviceClassValue; });
                set('nf-log-title', function (el) { el.textContent = t.logTitle; });
                set('nf-restart-label', function (el) { el.textContent = t.restartLabel; });
                set('nf-suggest-title', function (el) { el.textContent = t.suggestTitle; });
                set('nf-home', function (el) { el.href = t.homePath; el.textContent = t.homeLink; });
                set('nf-start', function (el) { el.href = t.startPath; el.textContent = t.startLink; });
                set('nf-ha', function (el) { el.href = t.haPath; el.textContent = t.haLink; });
                set('nf-esp', function (el) { el.href = t.espPath; el.textContent = t.espLink; });
                set('nf-popular-title', function (el) { el.textContent = t.popularTitle; });
                set('nf-popular-links', function (el) {
                    var links = el.querySelectorAll('a');
                    t.guides.forEach(function (guide, index) {
                        if (links[index]) {
                            links[index].href = guide.href;
                            links[index].textContent = guide.text;
                        }
                    });
                });
                set('nf-lang-switch', function (el) {
                    el.href = t.langSwitch.href;
                    el.textContent = t.langSwitch.flag + ' ' + t.langSwitch.text;
                });
            }

            // --- 2. Show the path that actually 404'd as an entity attribute.
            var shownPath = path;
            try {
                shownPath = decodeURIComponent(path);
            } catch (error) {
                // Malformed percent-encoding: fall back to the raw pathname.
            }
            if (shownPath.length > 64) shownPath = shownPath.slice(0, 63) + '…';
            // textContent, never innerHTML — the path is visitor-controlled.
            set('nf-path', function (el) { el.textContent = shownPath; });

            // --- 3. last_changed ticks up from page load, like a live entity.
            var loadedAt = Date.now();
            function clockAt(offsetMs) {
                var d = new Date(loadedAt + (offsetMs || 0));
                function pad(n) { return n < 10 ? '0' + n : String(n); }
                return pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
            }
            function tick() {
                var seconds = Math.round((Date.now() - loadedAt) / 1000);
                var text;
                if (seconds < 2) text = t.justNow;
                else if (seconds < 60) text = relativeTime.seconds(seconds);
                else text = relativeTime.minutes(Math.floor(seconds / 60));
                set('nf-changed', function (el) { el.textContent = text; });
            }
            tick();
            setInterval(tick, 1000);

            // --- 4. Logbook. The rows are rendered server-side (Astro scopes
            // <style> with a class JS-created nodes never get); only the
            // timestamps and the Danish/English text are filled in here.
            var logRows = document.querySelectorAll('#nf-log li');
            var baseCount = t.logLines.length;
            for (var i = 0; i < baseCount; i++) {
                if (!logRows[i]) continue;
                logRows[i].querySelector('.log-time').textContent = clockAt(-3000 + i * 1000);
                logRows[i].querySelector('.log-text').textContent = t.logLines[i];
            }

            // --- 5. The joke every Home Assistant user has lived through.
            var card = document.getElementById('nf-card');
            var restartButton = document.getElementById('nf-restart');
            var restartCount = 0;
            if (card && restartButton) {
                restartButton.addEventListener('click', function () {
                    if (restartCount >= t.restartLines.length) return;
                    var line = t.restartLines[restartCount];
                    restartCount++;

                    card.classList.add('is-restarting');
                    restartButton.disabled = true;
                    set('nf-state', function (el) { el.textContent = t.restartingLabel; });
                    set('nf-restart-label', function (el) { el.textContent = t.restartBusy; });

                    setTimeout(function () {
                        card.classList.remove('is-restarting');
                        set('nf-state', function (el) { el.textContent = t.stateLabel; });
                        var row = logRows[baseCount + restartCount - 1];
                        if (row) {
                            row.querySelector('.log-time').textContent = clockAt(Date.now() - loadedAt);
                            row.querySelector('.log-text').textContent = line;
                            row.hidden = false;
                        }
                        if (restartCount >= t.restartLines.length) {
                            restartButton.remove();
                        } else {
                            restartButton.disabled = false;
                            set('nf-restart-label', function (el) { el.textContent = t.restartLabel; });
                        }
                    }, 1400);
                });
            }

            // --- 6. "Mente du?" — the closest real pages to the broken URL,
            // scored with a Dice coefficient over character bigrams.
            function normalise(value) {
                return value.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
            }

            function bigrams(value) {
                var map = new Map();
                for (var i = 0; i < value.length - 1; i++) {
                    var gram = value.slice(i, i + 2);
                    map.set(gram, (map.get(gram) || 0) + 1);
                }
                return map;
            }

            function dice(a, b) {
                if (!a.size || !b.size) return 0;
                var hits = 0;
                var total = 0;
                a.forEach(function (count, gram) {
                    total += count;
                    var other = b.get(gram);
                    if (other) hits += Math.min(count, other);
                });
                b.forEach(function (count) { total += count; });
                return (2 * hits) / total;
            }

            function stripLang(value) {
                return value.replace(/^\/(da|en)\//, '/');
            }

            function headSegment(value) {
                return stripLang(value).split('/').filter(Boolean)[0] || '';
            }

            var requested = normalise(stripLang(path));
            // A bare "/" or a direct visit to /404 is not a broken link.
            if (requested && path !== '/404' && path !== '/404/') {
                var requestedGrams = bigrams(requested);
                var langPrefix = lang === 'en' ? '/en/' : '/da/';
                var requestedHead = headSegment(path);

                var ranked = pageIndex
                    .filter(function (page) { return page.p.indexOf(langPrefix) === 0; })
                    .map(function (page) {
                        var score = dice(requestedGrams, bigrams(normalise(stripLang(page.p))));
                        // Landing in the right section is a strong signal by itself.
                        if (requestedHead && headSegment(page.p) === requestedHead) score += 0.15;
                        return { page: page, score: score };
                    })
                    .filter(function (entry) { return entry.score >= 0.34; })
                    .sort(function (a, b) { return b.score - a.score; })
                    .slice(0, 3);

                if (ranked.length) {
                    var items = document.querySelectorAll('#nf-suggest-list li');
                    ranked.forEach(function (entry, index) {
                        var item = items[index];
                        if (!item) return;
                        var link = item.querySelector('a');
                        link.href = entry.page.p;
                        link.querySelector('.suggest-text').textContent = entry.page.t;
                        link.querySelector('.suggest-path').textContent = entry.page.p;
                        item.hidden = false;
                    });
                    document.getElementById('nf-suggest').hidden = false;
                }
            }
        })();
    </script>
</body>
</html>
