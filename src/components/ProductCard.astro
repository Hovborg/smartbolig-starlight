---
/**
 * Product Card Component for SmartBolig.net
 * Displays a product with image, specs, and affiliate buy link
 *
 * Usage:
 * <ProductCard
 *   name="Sonoff Zigbee 3.0 USB Dongle Plus"
 *   image="/images/products/sonoff-dongle.jpg"
 *   price="149 kr"
 *   rating={5}
 *   store="proshop"
 *   url="https://www.proshop.dk/..."
 *   badge="Anbefalet"
 * >
 *   Bedste Zigbee coordinator til prisen. Understøtter Zigbee2MQTT.
 * </ProductCard>
 */

import { affiliateMerchants, buildAffiliateUrl, type AffiliateStore } from '../lib/affiliate';

interface Props {
  name: string;
  image?: string;
  price?: string;
  rating?: number;
  store?: AffiliateStore;
  url?: string;
  badge?: string;
}

const { name, image, price, rating, store, url, badge } = Astro.props;

// Locale-aware UI text (same URL-based detection as FAQ.astro / Head.astro).
const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'da';

const affiliateUrl = url && store ? buildAffiliateUrl(store, url) : url;
const stars = rating ? '★'.repeat(rating) + '☆'.repeat(5 - rating) : null;
---

<div class="product-card">
  {badge && <span class="product-badge">{badge}</span>}

  {image ? (
    <div class="product-image">
      <img src={image} alt={name} loading="lazy" />
    </div>
  ) : (
    <div class="product-image product-image-placeholder" aria-hidden="true">
      <span>📦</span>
    </div>
  )}

  <div class="product-content">
    <h3 class="product-name">{name}</h3>

    {stars && (
      <div
        class="product-rating"
        role="img"
        aria-label={lang === 'en' ? `Rated ${rating} out of 5 stars` : `Bedømt ${rating} ud af 5 stjerner`}
      >
        <span aria-hidden="true">{stars}</span>
      </div>
    )}

    <div class="product-description">
      <slot />
    </div>

    <div class="product-footer">
      {price && <span class="product-price">{price}</span>}

      {affiliateUrl && store && (
        <a
          href={affiliateUrl}
          target="_blank"
          rel="noopener sponsored nofollow"
          class="product-buy-btn"
        >
          {lang === 'en' ? 'Buy at' : 'Køb hos'} {affiliateMerchants[store].name} →
          <span class="affiliate-label">{lang === 'en' ? 'Ad link' : 'Reklamelink'}</span>
          <span class="sr-only">{lang === 'en' ? '(opens in a new tab)' : '(åbner i ny fane)'}</span>
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--sb-surface);
    border: 1px solid var(--sb-line);
    border-radius: var(--sb-radius-md);
    overflow: hidden;
  }

  .product-card:hover {
    border-color: var(--sb-accent);
    box-shadow: var(--sb-shadow-md);
  }

  .product-badge {
    position: absolute;
    top: var(--sb-space-3);
    right: var(--sb-space-3);
    background: var(--sb-accent);
    color: var(--sb-on-accent);
    padding: var(--sb-space-1) var(--sb-space-3);
    border-radius: var(--sb-radius-pill);
    font-size: var(--sb-text-xs);
    font-weight: 600;
    z-index: 1;
  }

  .product-image {
    width: 100%;
    height: 160px;
    background: var(--sb-bg-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--sb-space-4);
  }

  .product-image-placeholder {
    font-size: 3rem;
    opacity: 0.3;
  }

  .product-content {
    padding: var(--sb-space-4);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .product-name {
    font-family: var(--sb-font-display);
    font-size: var(--sb-text-base);
    font-weight: 600;
    margin: 0 0 var(--sb-space-2) 0;
    color: var(--sb-ink-strong);
    line-height: 1.3;
  }

  .product-rating {
    color: var(--sb-warm);
    font-size: var(--sb-text-sm);
    letter-spacing: 1px;
    margin-bottom: var(--sb-space-2);
  }

  .product-description {
    font-size: var(--sb-text-sm);
    color: var(--sb-ink-muted);
    line-height: 1.5;
    flex-grow: 1;
    margin-bottom: var(--sb-space-4);
  }

  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sb-space-4);
    flex-wrap: wrap;
  }

  .product-price {
    font-size: var(--sb-text-lg);
    font-weight: 700;
    color: var(--sb-warm);
  }

  .product-buy-btn {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    padding: var(--sb-space-2) var(--sb-space-4);
    background: var(--sb-accent);
    color: var(--sb-on-accent);
    text-decoration: none;
    border-radius: var(--sb-radius-sm);
    font-size: var(--sb-text-sm);
    font-weight: 500;
  }

  .affiliate-label {
    font-size: var(--sb-text-xs);
    font-weight: 400;
  }

  .product-buy-btn:hover {
    background: var(--sb-accent-strong);
  }

  .product-buy-btn:focus-visible {
    outline: 2px solid var(--sb-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-card {
      transition:
        border-color var(--sb-dur) var(--sb-ease),
        box-shadow var(--sb-dur) var(--sb-ease);
    }

    .product-buy-btn {
      transition:
        background-color var(--sb-dur) var(--sb-ease),
        transform var(--sb-dur) var(--sb-ease);
    }

    .product-buy-btn:hover {
      transform: translateY(-1px);
    }
  }
</style>