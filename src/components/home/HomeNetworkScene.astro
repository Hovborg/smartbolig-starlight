---
// Hero illustration: one house through a day. The visitor picks a time of day
// and sees which automations run. Works without JavaScript: the radio buttons
// drive the drawing through CSS (src/styles/home/scene.css).
import type { HomeSceneCopy } from "../../lib/home-copy";

interface Props {
  copy: HomeSceneCopy;
}

const { copy } = Astro.props;
const systems = ["light", "heat", "energy", "security"] as const;
---

<fieldset class="home-scene__modes">
  <legend>{copy.choose}</legend>
  {copy.modes.map((mode) => (
    <>
      <input
        type="radio"
        name="home-scene-mode"
        id={`home-scene-${mode.id}`}
        aria-describedby={`home-scene-rule-${mode.id}`}
        checked={mode.id === "evening"}
      />
      <label for={`home-scene-${mode.id}`}>{mode.label}</label>
    </>
  ))}
</fieldset>

<div class="home-scene__stage">
  <svg class="home-house" viewBox="0 0 720 470" fill="none" aria-hidden="true" focusable="false">
    <circle class="hs-sun" cx="0" cy="0" r="26" />
    <path class="hs-moon" d="M606 44a30 30 0 1 0 30 38 24 24 0 0 1-30-38Z" />
    <ellipse class="hs-ground" cx="360" cy="392" rx="270" ry="62" />

    <!-- Light falling out of the windows and the door -->
    <path class="hs-spill" d="m205 300 51 30-64 44-74-40Zm230 0 83-48 84 44-92 60Z" />

    <!-- Roof with two solar panels -->
    <path class="hs-roof" d="m360 60 180 105-180 105-180-105Z" />
    <path class="hs-panel" d="m351 97 54 31-108 63-54-31Zm72 42 54 31-108 63-54-31Z" />
    <path class="hs-panel-grid" d="m378 113-108 63m153-37-108 63m-45-71 54 31m18-42 54 31" />
    <path class="hs-ray home-motion home-flow" d="M318 78 300 40m60 20V16m42 62 18-38" />

    <!-- Walls -->
    <path class="hs-wall hs-wall--left" d="m180 165 180 105v110L180 275Z" />
    <path class="hs-wall hs-wall--right" d="m360 270 180-105v110L360 380Z" />

    <!-- Windows, blinds and door -->
    <path class="hs-window" d="m205 204 51 29v44l-51-29Zm79 46 51 30v44l-51-30Zm152 0 82-48v48l-82 49Z" />
    <path class="hs-blind" d="m205 216 51 29m-51-17 51 29m-51-17 51 29m28 6 51 30m-51-18 51 30m-51-18 51 30m101-66 82-48m-82 60 82-48m-82 60 82-48" />
    <path class="hs-door" d="m382 290 32-18v77l-32 18Z" />
    <circle class="hs-handle" cx="407" cy="318" r="2.5" />
    <g class="hs-lock">
      <circle cx="398" cy="252" r="15" />
      <path d="M392 251v-3a6 6 0 0 1 12 0v3m-14 0h16v10h-16Z" />
    </g>

    <!-- Radiator with rising heat -->
    <path class="hs-radiator" d="m450 299 54-32v18l-54 31Zm13-8v18m14-26v18m13-25v17" />
    <g class="hs-heat home-motion home-float">
      <path d="M462 286c-5-6 5-9 0-15m15 6c-5-6 5-9 0-15m15 6c-5-6 5-9 0-15" />
    </g>

    <!-- The hub and the signals it sends -->
    <g class="hs-routes">
      <path class="hs-route hs-route--light home-motion home-flow" d="M310 316v54l34 32" />
      <path class="hs-route hs-route--energy home-motion home-flow" d="M360 268v118" />
      <path class="hs-route hs-route--security home-motion home-flow" d="M398 364v18l-22 20" />
      <path class="hs-route hs-route--heat home-motion home-flow" d="M477 306v44l-97 54" />
    </g>
    <g transform="translate(360 416)">
      <ellipse class="hs-hub-ring home-motion home-ring home-delay" rx="62" ry="26" />
      <ellipse class="hs-hub-ring home-motion home-ring" rx="42" ry="18" />
      <path class="hs-hub" d="m-26-6 26-15 26 15v14L0 23-26 8Z" />
      <path class="hs-hub-mark" d="m-9-4 9-6 9 6m-15-2v8l6 4 6-4v-8" />
    </g>
  </svg>
</div>

<div class="home-scene__rules">
  {copy.modes.map((mode) => <p class="home-scene__rule" id={`home-scene-rule-${mode.id}`} data-mode={mode.id}>{mode.rule}</p>)}
</div>

<ul class="home-scene__systems" role="list">
  {systems.map((system) => <li data-system={system}><span aria-hidden="true"></span>{copy.systems[system]}</li>)}
</ul>
