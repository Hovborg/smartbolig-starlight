---
// Start/pause control for the homepage animations. The logic lives in
// src/lib/home-motion.mjs; the look in src/styles/home/motion.css.
import type { HomeMotionCopy } from "../../lib/home-copy";

interface Props {
  copy: HomeMotionCopy;
}

const { copy } = Astro.props;
---
<div class="home-motion-controls" data-home-controls hidden
  data-start={copy.start}
  data-pause={copy.pause}
  data-system={copy.system}
  data-manual={copy.manual}>
  <button type="button" data-motion-toggle>{copy.start}</button>
  <span data-motion-status></span>
  <button type="button" data-motion-system hidden>{copy.reset}</button>
</div>
<script>
  import { mountHomeMotion } from '../../lib/home-motion.mjs';
  let cleanup: (() => void) | undefined;
  function init() {
    cleanup?.();
    const control = document.querySelector('[data-home-controls]');
    cleanup = control ? mountHomeMotion(window, document, control) : undefined;
  }
  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = undefined; });
</script>
