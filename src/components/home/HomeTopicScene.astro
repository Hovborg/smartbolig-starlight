---
interface Props { topic: number }
const { topic } = Astro.props;
---
<svg class="home-topic-scene" viewBox="0 0 320 140" fill="none" aria-hidden="true" focusable="false">
  <path d="M0 120H320M0 100H320M0 80H320M40 0V140M80 0V140M120 0V140M160 0V140M200 0V140M240 0V140M280 0V140" stroke="currentColor" opacity=".055" />
  {topic === 0 && <>
    <ellipse cx="160" cy="115" rx="80" ry="12" fill="currentColor" opacity=".06"/>
    <g class="home-motion home-float"><path d="m109 64 51-39 51 39v48H109Z" fill="var(--home-panel)" stroke="currentColor" stroke-width="1.5"/><path d="m100 64 60-46 60 46M150 111V82h20v29" stroke="currentColor" stroke-width="2"/><rect class="home-motion home-lamp" x="121" y="68" width="17" height="17" rx="3" fill="currentColor" opacity=".4"/><rect class="home-motion home-lamp home-delay" x="183" y="68" width="17" height="17" rx="3" fill="currentColor" opacity=".4"/></g>
    <path class="home-motion home-flow" d="M46 48h27l32 26m169-26h-27l-32 26M55 110h45m120 0h45" stroke="currentColor" stroke-dasharray="3 7"/>
    {[ [40,45], [280,45], [45,110], [275,110] ].map(([cx,cy]) => <g><circle class="home-motion home-ring" cx={cx} cy={cy} r="13" stroke="currentColor" opacity=".35"/><circle cx={cx} cy={cy} r="4" fill="currentColor"/></g>)}
  </>}
  {topic === 1 && <>
    <path d="M49 71h222" stroke="currentColor" opacity=".2"/><path class="home-motion home-flow" d="M49 71h222" stroke="currentColor" stroke-width="2" stroke-dasharray="4 15"/>
    <rect x="27" y="46" width="48" height="50" rx="13" fill="var(--home-panel)" stroke="currentColor"/><path d="m53 56-13 18h11l-2 13 14-20H51Z" stroke="currentColor"/>
    <g class="home-motion home-float"><path d="m160 40 31 31-31 31-31-31Z" fill="var(--home-panel)" stroke="currentColor"/><path d="m150 71 7 7 13-15" stroke="currentColor" stroke-width="2"/></g>
    <rect x="245" y="46" width="48" height="50" rx="13" fill="var(--home-panel)" stroke="currentColor"/><circle class="home-motion home-ring" cx="269" cy="70" r="12" stroke="currentColor"/><path d="M269 56v14m-8-9a12 12 0 1 0 16 0" stroke="currentColor"/>
    <path d="M160 104v18H51v-20" stroke="currentColor" opacity=".25" stroke-dasharray="3 5"/>
  </>}
  {topic === 2 && <>
    <g stroke="currentColor" opacity=".35"><path d="M45 30h53l30 26m-83 56h53l30-26m147-56h-53l-30 26m83 56h-53l-30-26M160 10v30m0 62v28M15 71h110m70 0h110"/>{[45,275].map(cx => <><circle cx={cx} cy="30" r="4"/><circle cx={cx} cy="112" r="4"/></>)}</g>
    <path class="home-motion home-flow" d="M15 71h110m70 0h110M160 10v30m0 62v28" stroke="currentColor" stroke-width="2" stroke-dasharray="3 12"/>
    <rect x="117" y="29" width="86" height="84" rx="14" fill="currentColor" opacity=".07"/><rect x="130" y="42" width="60" height="58" rx="8" fill="var(--home-panel)" stroke="currentColor" stroke-width="2"/>
    <path d="M140 37V27m13 10V27m14 10V27m13 10V27M140 105v10m13-10v10m14-10v10m13-10v10" stroke="currentColor"/>
    <path class="home-motion home-scan" d="M140 56h40" stroke="currentColor" stroke-width="2"/><text x="160" y="82" text-anchor="middle" fill="currentColor" font-size="12" font-family="monospace">ESP32</text>
  </>}
  {topic === 3 && <>
    <rect x="123" y="24" width="74" height="103" rx="16" fill="var(--home-panel)" stroke="currentColor"/><rect x="132" y="34" width="56" height="78" rx="9" fill="currentColor" opacity=".06"/>
    <rect x="142" y="49" width="36" height="17" rx="8.5" stroke="currentColor"/><circle class="home-motion home-switch" cx="151" cy="57.5" r="5" fill="currentColor"/>
    <path d="M143 87h34m-34 10h22" stroke="currentColor" opacity=".4"/>
    <g class="home-motion home-float"><path d="M56 69a18 18 0 1 1 27 0l-3 12H59Zm6 19h15m-12 6h9" stroke="currentColor" stroke-width="1.7"/><circle class="home-motion home-ring" cx="69" cy="56" r="29" stroke="currentColor" opacity=".2"/></g>
    <rect x="234" y="47" width="43" height="48" rx="11" stroke="currentColor"/><circle cx="255" cy="70" r="11" stroke="currentColor"/><path d="M251 67v6m8-6v6" stroke="currentColor"/>
    <path class="home-motion home-flow" d="M90 72h30m80 0h30" stroke="currentColor" stroke-dasharray="3 7"/>
  </>}
  {topic === 4 && <>
    <g stroke="currentColor" opacity=".25"><path d="M57 38 125 32 192 70 263 33M57 38l68 68 67-36 71 39M57 103l68-71m-68 71 68 3 67-36M125 32v74m138-73v76"/></g>
    <path class="home-motion home-flow" d="M57 103 125 32 192 70 263 33M57 38l68 68 67-36 71 39" stroke="currentColor" stroke-dasharray="4 13"/>
    {[[57,38],[57,103],[125,32],[125,106],[263,33],[263,109]].map(([cx,cy], i) => <circle class:list={['home-motion','home-node',{'home-delay':i%2===0}]} cx={cx} cy={cy} r="6" fill="var(--home-panel)" stroke="currentColor" stroke-width="2"/>)}
    <circle class="home-motion home-ring" cx="192" cy="70" r="25" stroke="currentColor" opacity=".3"/><circle cx="192" cy="70" r="17" fill="var(--home-panel)" stroke="currentColor"/><path d="m192 58 3 9 9 3-9 3-3 9-3-9-9-3 9-3Z" fill="currentColor"/>
  </>}
</svg>
