---
// The small drawing on a tool's card. Drawn with the site's colour tokens, so
// it follows the theme. Decorative: the card's title says what the tool is.
// A new drawing is one more branch below, on the same 48 x 48 grid.
interface Props {
  name: "price" | "power";
}

const { name } = Astro.props;
---

<svg class="sb-tool-icon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" focusable="false">
  {name === "price" && (
    <g>
      <rect class="sb-tool-icon__dim" x="2" y="19" width="6" height="23" rx="2" />
      <rect class="sb-tool-icon__dim" x="10" y="11" width="6" height="31" rx="2" />
      <rect class="sb-tool-icon__hot" x="18" y="27" width="6" height="15" rx="2" />
      <rect class="sb-tool-icon__hot" x="26" y="31" width="6" height="11" rx="2" />
      <rect class="sb-tool-icon__dim" x="34" y="21" width="6" height="21" rx="2" />
      <rect class="sb-tool-icon__dim" x="42" y="6" width="6" height="36" rx="2" />
    </g>
  )}
  {name === "power" && (
    <g>
      <path class="sb-tool-icon__line" d="M18 6v10M30 6v10" />
      <path class="sb-tool-icon__hot sb-tool-icon__line" d="M12 16h24v5a12 12 0 0 1-24 0z" />
      <path class="sb-tool-icon__line" d="M24 33v9" />
    </g>
  )}
</svg>

<style>
  .sb-tool-icon {
    display: block;
    inline-size: 3rem;
    block-size: 3rem;
  }

  .sb-tool-icon__dim {
    fill: color-mix(in srgb, var(--sb-ink-subtle) 55%, transparent);
  }

  .sb-tool-icon__hot {
    fill: var(--sb-accent-vivid);
  }

  .sb-tool-icon__line {
    stroke: var(--sb-ink-strong);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sb-tool-icon__line:not(.sb-tool-icon__hot) {
    fill: none;
  }
</style>
