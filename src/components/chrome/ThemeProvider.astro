---
// Sets the theme before the first paint. Dark is the default; the visitor picks
// light with the theme switch (ThemeSelect.astro stores the choice). Also keeps
// the browser's theme colour in step, and prints in the light theme. Works
// when browser storage is blocked.
---

<script is:inline>
  (() => {
    const root = document.documentElement;
    const read = () => {
      try {
        const stored = localStorage.getItem("starlight-theme");
        return stored === "light" || stored === "dark" ? stored : null;
      } catch {
        return null; // Storage can be blocked in private or embedded contexts.
      }
    };
    // The meta tag carries both colours (config/head/icons.mjs); none live here.
    const syncThemeColor = () => {
      const meta = document.querySelector('meta[name="theme-color"]');
      const color = meta?.dataset[root.dataset.theme];
      if (color) meta.content = color;
    };
    root.dataset.theme = read() || "dark";
    syncThemeColor();
    // Paper is white: print in the light theme (code blocks follow it too),
    // then return to the theme the page had. Without JavaScript the print
    // rules in styles/print.css still give dark text.
    let beforePrint = null;
    addEventListener("beforeprint", () => {
      beforePrint = root.dataset.theme;
      root.dataset.theme = "light";
    });
    addEventListener("afterprint", () => {
      root.dataset.theme = beforePrint || read() || "dark";
      beforePrint = null;
    });
    new MutationObserver(syncThemeColor).observe(root, { attributes: true, attributeFilter: ["data-theme"] });
  })();
</script>
