---
interface Props {
  locale?: string;
}

const { locale = 'da' } = Astro.props;
const lang = locale === 'en' ? 'en' : 'da';

const translations = {
  da: {
    launcher: 'Spørg AI',
    launcherLabel: 'Spørg SmartBolig AI',
    eyebrow: 'SmartBolig // AI Core',
    systemStatus: 'EDGE AI · ONLINE',
    systemDetail: 'Bred ekspertviden + SmartBolig-kilder',
    title: 'SmartBolig AI',
    description: 'Din tekniske sparringspartner til Home Assistant, ESPHome, sensorer og homelab.',
    intro:
      'Få hjælp til fejlsøgning, arkitektur og konkrete konfigurationer. Jeg bruger bred AI-viden og finder SmartBolig-guides, når de gør svaret bedre.',
    newChat: 'Ny samtale',
    close: 'Luk assistenten',
    suggestions: 'Prøv et godt udgangspunkt',
    prompt1: 'Fejlsøg min Home Assistant-automation',
    prompt1Meta: 'AUTOMATION',
    prompt2: 'Byg en ESPHome-sensor',
    prompt2Meta: 'FIRMWARE',
    prompt3: 'Vælg Zigbee-, Matter- eller Wi-Fi-sensor',
    prompt3Meta: 'ENHEDER',
    prompt4: 'Design et stabilt homelab',
    prompt4Meta: 'INFRASTRUKTUR',
    placeholder: 'Beskriv dit setup, målet og hvad der går galt …',
    send: 'Send',
    sending: 'Tænker',
    privacy: 'Del ikke adgangskoder, tokens eller personoplysninger.',
    general: 'Generel AI-viden',
    mixed: 'SmartBolig-kilder + bred AI-viden',
    official: 'Officielle kilder kontrolleret',
    sources: 'Kilder',
    copy: 'Kopiér',
    copied: 'Kopieret',
    retry: 'Prøv igen',
    ready: 'Klar til dit spørgsmål.',
    resetDone: 'Samtalen er ryddet.',
    errorRate: 'Du har sendt mange beskeder på kort tid. Vent et øjeblik og prøv igen.',
    errorService: 'Assistenten er ikke klar lige nu. Prøv igen senere.',
    errorTimeout: 'Svaret tog for lang tid. Prøv igen.',
    errorGeneric: 'Jeg kunne ikke svare denne gang. Prøv igen om lidt.',
    assistant: 'SmartBolig AI',
    you: 'Dig',
  },
  en: {
    launcher: 'Ask AI',
    launcherLabel: 'Ask SmartBolig AI',
    eyebrow: 'SmartBolig // AI Core',
    systemStatus: 'EDGE AI · ONLINE',
    systemDetail: 'Broad expertise + SmartBolig sources',
    title: 'SmartBolig AI',
    description: 'Your technical partner for Home Assistant, ESPHome, sensors and homelabs.',
    intro:
      'Get help with troubleshooting, architecture and concrete configuration. I use broad AI knowledge and find SmartBolig guides when they improve the answer.',
    newChat: 'New chat',
    close: 'Close the assistant',
    suggestions: 'Start with a useful question',
    prompt1: 'Troubleshoot my Home Assistant automation',
    prompt1Meta: 'AUTOMATION',
    prompt2: 'Build an ESPHome sensor',
    prompt2Meta: 'FIRMWARE',
    prompt3: 'Choose a Zigbee, Matter or Wi-Fi sensor',
    prompt3Meta: 'DEVICES',
    prompt4: 'Design a reliable homelab',
    prompt4Meta: 'INFRASTRUCTURE',
    placeholder: 'Describe your setup, goal and what is going wrong …',
    send: 'Send',
    sending: 'Thinking',
    privacy: 'Do not share passwords, tokens or personal data.',
    general: 'General AI knowledge',
    mixed: 'SmartBolig sources + broad AI knowledge',
    official: 'Official sources checked',
    sources: 'Sources',
    copy: 'Copy',
    copied: 'Copied',
    retry: 'Try again',
    ready: 'Ready for your question.',
    resetDone: 'The conversation has been cleared.',
    errorRate: 'You sent many messages in a short time. Wait a moment and try again.',
    errorService: 'The assistant is not ready right now. Please try again later.',
    errorTimeout: 'The response took too long. Please try again.',
    errorGeneric: 'I could not answer this time. Please try again shortly.',
    assistant: 'SmartBolig AI',
    you: 'You',
  },
};

const t = translations[lang];
---

<div
  class="smartbolig-ai"
  data-smartbolig-ai
  data-locale={lang}
  data-label-assistant={t.assistant}
  data-label-you={t.you}
  data-label-copy={t.copy}
  data-label-copied={t.copied}
  data-label-retry={t.retry}
  data-label-ready={t.ready}
  data-label-reset={t.resetDone}
  data-label-general={t.general}
  data-label-mixed={t.mixed}
  data-label-official={t.official}
  data-label-sources={t.sources}
  data-error-rate={t.errorRate}
  data-error-service={t.errorService}
  data-error-timeout={t.errorTimeout}
  data-error-generic={t.errorGeneric}
>
  <button
    class="smartbolig-ai__launcher"
    type="button"
    aria-label={t.launcherLabel}
    aria-expanded="false"
    aria-controls="smartbolig-ai-panel"
    data-chat-launcher
  >
    <span class="smartbolig-ai__orb smartbolig-ai__core-chip" aria-hidden="true">
      <span class="smartbolig-ai__core-pulse"></span>
      <svg viewBox="0 0 32 32">
        <rect x="9" y="9" width="14" height="14" rx="3"></rect>
        <path d="M13 3v6M19 3v6M13 23v6M19 23v6M3 13h6M3 19h6M23 13h6M23 19h6"></path>
        <path d="m13 17 2-5 2 8 2-5"></path>
      </svg>
    </span>
    <span class="smartbolig-ai__launcher-copy">
      <span class="smartbolig-ai__launcher-kicker">SMARTBOLIG AI</span>
      <span class="smartbolig-ai__launcher-title">{t.launcher}</span>
      <span class="smartbolig-ai__launcher-status" data-chat-system-status>
        <span class="smartbolig-ai__status-dot" aria-hidden="true"></span>
        {t.systemStatus}
      </span>
    </span>
    <svg class="smartbolig-ai__launcher-chevron" viewBox="0 0 24 24" aria-hidden="true">
      <path d="m9 6 6 6-6 6"></path>
    </svg>
  </button>

  <section
    class="smartbolig-ai__panel"
    id="smartbolig-ai-panel"
    role="dialog"
    aria-labelledby="smartbolig-ai-title"
    aria-describedby="smartbolig-ai-description"
    aria-busy="false"
    hidden
    data-chat-panel
  >
    <header class="smartbolig-ai__header">
      <div class="smartbolig-ai__brand">
        <span class="smartbolig-ai__mark smartbolig-ai__core-chip" aria-hidden="true">
          <svg viewBox="0 0 32 32">
            <rect x="9" y="9" width="14" height="14" rx="3"></rect>
            <path d="M13 3v6M19 3v6M13 23v6M19 23v6M3 13h6M3 19h6M23 13h6M23 19h6"></path>
            <path d="m13 17 2-5 2 8 2-5"></path>
          </svg>
        </span>
        <div>
          <p class="smartbolig-ai__eyebrow">{t.eyebrow}</p>
          <h2 id="smartbolig-ai-title">{t.title}</h2>
        </div>
      </div>
      <div class="smartbolig-ai__header-actions">
        <button class="smartbolig-ai__icon-button" type="button" title={t.newChat} aria-label={t.newChat} data-chat-reset>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5a7 7 0 1 1-6.2 3.75"></path>
            <path d="M3.5 5.5v4h4"></path>
          </svg>
        </button>
        <button class="smartbolig-ai__icon-button" type="button" title={t.close} aria-label={t.close} data-chat-close>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
    </header>

    <div class="smartbolig-ai__system-bar">
      <p class="smartbolig-ai__description" id="smartbolig-ai-description">{t.description}</p>
      <div class="smartbolig-ai__system-state" data-chat-system-status>
        <span class="smartbolig-ai__status-dot" aria-hidden="true"></span>
        <span>
          <strong>{t.systemStatus}</strong>
          <small>{t.systemDetail}</small>
        </span>
      </div>
    </div>

    <div class="smartbolig-ai__conversation" data-chat-conversation>
      <div
        class="smartbolig-ai__messages"
        role="log"
        aria-live="polite"
        aria-relevant="additions"
        data-chat-messages
      ></div>

      <div class="smartbolig-ai__welcome" data-chat-welcome>
        <div class="smartbolig-ai__core-visual" aria-hidden="true">
          <span class="smartbolig-ai__core-ring smartbolig-ai__core-ring--outer"></span>
          <span class="smartbolig-ai__core-ring smartbolig-ai__core-ring--inner"></span>
          <span class="smartbolig-ai__core-node smartbolig-ai__core-node--one"></span>
          <span class="smartbolig-ai__core-node smartbolig-ai__core-node--two"></span>
          <span class="smartbolig-ai__core-node smartbolig-ai__core-node--three"></span>
          <svg viewBox="0 0 32 32">
            <rect x="9" y="9" width="14" height="14" rx="3"></rect>
            <path d="M13 3v6M19 3v6M13 23v6M19 23v6M3 13h6M3 19h6M23 13h6M23 19h6"></path>
            <path d="m13 17 2-5 2 8 2-5"></path>
          </svg>
        </div>
        <p>{t.intro}</p>
        <div class="smartbolig-ai__capability-grid" aria-label={lang === 'en' ? 'Areas of expertise' : 'Fagområder'}>
          <span><i aria-hidden="true"></i><strong>Home Assistant</strong><small>Automations</small></span>
          <span><i aria-hidden="true"></i><strong>ESPHome</strong><small>Firmware</small></span>
          <span><i aria-hidden="true"></i><strong>Zigbee · Matter</strong><small>Devices</small></span>
          <span><i aria-hidden="true"></i><strong>Homelab</strong><small>Infrastructure</small></span>
        </div>
      </div>

      <div class="smartbolig-ai__prompts" data-chat-prompts>
        <p>{t.suggestions}</p>
        <button type="button" data-chat-prompt data-prompt={t.prompt1}>
          <span class="smartbolig-ai__prompt-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 18h4l2-12 4 12 2-8 2 8h2"></path></svg>
          </span>
          <span class="smartbolig-ai__prompt-copy"><small>{t.prompt1Meta}</small><strong>{t.prompt1}</strong></span>
          <span class="smartbolig-ai__prompt-arrow" aria-hidden="true">↗</span>
        </button>
        <button type="button" data-chat-prompt data-prompt={t.prompt2}>
          <span class="smartbolig-ai__prompt-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"></rect><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"></path></svg>
          </span>
          <span class="smartbolig-ai__prompt-copy"><small>{t.prompt2Meta}</small><strong>{t.prompt2}</strong></span>
          <span class="smartbolig-ai__prompt-arrow" aria-hidden="true">↗</span>
        </button>
        <button type="button" data-chat-prompt data-prompt={t.prompt3}>
          <span class="smartbolig-ai__prompt-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 8a10 10 0 0 1 14 0M8 11a6 6 0 0 1 8 0M10.5 14a2.5 2.5 0 0 1 3 0"></path><circle cx="12" cy="18" r="1"></circle></svg>
          </span>
          <span class="smartbolig-ai__prompt-copy"><small>{t.prompt3Meta}</small><strong>{t.prompt3}</strong></span>
          <span class="smartbolig-ai__prompt-arrow" aria-hidden="true">↗</span>
        </button>
        <button type="button" data-chat-prompt data-prompt={t.prompt4}>
          <span class="smartbolig-ai__prompt-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="6" rx="2"></rect><rect x="4" y="14" width="16" height="6" rx="2"></rect><path d="M8 7h.01M8 17h.01M12 7h5M12 17h5"></path></svg>
          </span>
          <span class="smartbolig-ai__prompt-copy"><small>{t.prompt4Meta}</small><strong>{t.prompt4}</strong></span>
          <span class="smartbolig-ai__prompt-arrow" aria-hidden="true">↗</span>
        </button>
      </div>
    </div>

    <div class="smartbolig-ai__composer">
      <form data-chat-form>
        <label class="sr-only" for="smartbolig-ai-input">{t.placeholder}</label>
        <span class="smartbolig-ai__command-prompt" aria-hidden="true">&gt;_</span>
        <textarea
          id="smartbolig-ai-input"
          rows="1"
          maxlength="2000"
          enterkeyhint="send"
          placeholder={t.placeholder}
          data-chat-input
        ></textarea>
        <button class="smartbolig-ai__send" type="submit" aria-label={t.send} data-chat-send>
          <span>{t.send}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m5 12 14-7-4.5 14-3-5.5L5 12Z"></path>
            <path d="m11.5 13.5 3-3"></path>
          </svg>
        </button>
      </form>
      <div class="smartbolig-ai__composer-meta">
        <p>{t.privacy}</p>
        <span role="status" aria-live="polite" data-chat-status>{t.ready}</span>
      </div>
    </div>
  </section>
</div>

<script>
  const MAX_HISTORY_MESSAGES = 10;
  const MAX_MESSAGE_CHARS = 2000;
  const REQUEST_TIMEOUT_MS = 120_000;
  const SAFE_SOURCE_HOSTS = new Set(["smartbolig.net", "www.home-assistant.io", "esphome.io"]);

  function setupAssistant(root) {
    if (!(root instanceof HTMLElement) || root.dataset.chatReady === "true") return;
    root.dataset.chatReady = "true";

    const panel = root.querySelector("[data-chat-panel]");
    const launcher = root.querySelector("[data-chat-launcher]");
    const closeButton = root.querySelector("[data-chat-close]");
    const resetButton = root.querySelector("[data-chat-reset]");
    const form = root.querySelector("[data-chat-form]");
    const input = root.querySelector("[data-chat-input]");
    const sendButton = root.querySelector("[data-chat-send]");
    const messagesElement = root.querySelector("[data-chat-messages]");
    const welcome = root.querySelector("[data-chat-welcome]");
    const prompts = root.querySelector("[data-chat-prompts]");
    const status = root.querySelector("[data-chat-status]");
    const promptButtons = root.querySelectorAll("[data-chat-prompt]");

    if (
      !(panel instanceof HTMLElement) ||
      !(launcher instanceof HTMLButtonElement) ||
      !(closeButton instanceof HTMLButtonElement) ||
      !(resetButton instanceof HTMLButtonElement) ||
      !(form instanceof HTMLFormElement) ||
      !(input instanceof HTMLTextAreaElement) ||
      !(sendButton instanceof HTMLButtonElement) ||
      !(messagesElement instanceof HTMLElement) ||
      !(welcome instanceof HTMLElement) ||
      !(prompts instanceof HTMLElement) ||
      !(status instanceof HTMLElement)
    ) {
      return;
    }

    const locale = root.dataset.locale === "en" ? "en" : "da";
    const storageKey = `smartbolig-ai:v1:${locale}`;
    let history = loadHistory();
    let isSending = false;
    let abortController = null;
    let lastFailed = false;
    let requestSequence = 0;

    function setStatus(message) {
      status.textContent = message;
    }

    function normalizeStoredMessage(message) {
      if (!message || typeof message !== "object") return null;
      if (message.role !== "user" && message.role !== "assistant") return null;
      if (typeof message.content !== "string") return null;
      const content = message.content.trim().slice(0, MAX_MESSAGE_CHARS);
      if (!content) return null;

      const normalized = { role: message.role, content };
      if (message.role === "assistant") {
        normalized.sourceMode =
          message.sourceMode === "official" ? "official" : message.sourceMode === "mixed" ? "mixed" : "general";
        if (Array.isArray(message.sources)) {
          normalized.sources = message.sources.slice(0, 5).filter((source) => {
            if (!source || typeof source.title !== "string" || typeof source.url !== "string") return false;
            try {
              const sourceUrl = new URL(source.url);
              return (
                sourceUrl.protocol === "https:" &&
                !sourceUrl.port &&
                !sourceUrl.username &&
                !sourceUrl.password &&
                SAFE_SOURCE_HOSTS.has(sourceUrl.hostname)
              );
            } catch {
              return false;
            }
          });
        }
      }
      return normalized;
    }

    function loadHistory() {
      try {
        const parsed = JSON.parse(sessionStorage.getItem(storageKey) || "[]");
        if (!Array.isArray(parsed)) return [];

        const safe = [];
        for (const candidate of parsed.slice(-MAX_HISTORY_MESSAGES)) {
          const message = normalizeStoredMessage(candidate);
          if (!message) continue;
          if (safe.length === 0 && message.role !== "user") continue;
          if (safe.at(-1)?.role === message.role) continue;
          safe.push(message);
        }
        return safe;
      } catch {
        return [];
      }
    }

    function saveHistory() {
      try {
        sessionStorage.setItem(storageKey, JSON.stringify(history.slice(-MAX_HISTORY_MESSAGES)));
      } catch {
        // Storage may be unavailable in hardened/private browser contexts.
      }
    }

    function createSafeSourceLink(source) {
      if (!source || typeof source.title !== "string" || typeof source.url !== "string") return null;
      let sourceUrl;
      try {
        sourceUrl = new URL(source.url);
      } catch {
        return null;
      }
      if (sourceUrl.protocol !== "https:" || sourceUrl.port || sourceUrl.username || sourceUrl.password) return null;
      if (!SAFE_SOURCE_HOSTS.has(sourceUrl.hostname)) return null;

      const sourceLink = document.createElement("a");
      sourceLink.className = "smartbolig-ai__source";
      sourceLink.dataset.sourceType = sourceUrl.hostname === "smartbolig.net" ? "smartbolig" : "official";
      sourceLink.href = sourceUrl.toString();
      sourceLink.target = "_blank";
      sourceLink.rel = "noopener noreferrer";
      sourceLink.textContent = source.title.slice(0, 100);
      return sourceLink;
    }

    function createCopyButton(content) {
      const button = document.createElement("button");
      button.className = "smartbolig-ai__message-action";
      button.type = "button";
      button.textContent = root.dataset.labelCopy || "Copy";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(content);
          button.textContent = root.dataset.labelCopied || "Copied";
          setTimeout(() => {
            button.textContent = root.dataset.labelCopy || "Copy";
          }, 1600);
        } catch {
          setStatus(root.dataset.errorGeneric || "Could not copy.");
        }
      });
      return button;
    }

    function appendInlineFormatting(element, content) {
      const tokenPattern = /(\*\*[^*\n]+\*\*|`[^`\n]+`)/g;
      let cursor = 0;

      for (const match of content.matchAll(tokenPattern)) {
        const index = match.index ?? 0;
        if (index > cursor) {
          element.append(document.createTextNode(content.slice(cursor, index)));
        }

        const token = match[0];
        const formatted = token.startsWith("**")
          ? document.createElement("strong")
          : document.createElement("code");
        formatted.textContent = token.startsWith("**") ? token.slice(2, -2) : token.slice(1, -1);
        element.append(formatted);
        cursor = index + token.length;
      }

      if (cursor < content.length) {
        element.append(document.createTextNode(content.slice(cursor)));
      }
    }

    function createSafeRichText(content) {
      const container = document.createElement("div");
      container.className = "smartbolig-ai__rich-text";
      const lines = String(content).replace(/\r\n?/g, "\n").split("\n");
      let paragraphLines = [];
      let list = null;
      let listKind = "";

      const flushParagraph = () => {
        if (paragraphLines.length === 0) return;
        const paragraph = document.createElement("p");
        appendInlineFormatting(paragraph, paragraphLines.join(" "));
        container.append(paragraph);
        paragraphLines = [];
      };

      const closeList = () => {
        list = null;
        listKind = "";
      };

      for (const rawLine of lines) {
        const line = rawLine.trim();
        if (!line) {
          flushParagraph();
          closeList();
          continue;
        }

        const headingMatch = line.match(/^#{1,4}\s+(.+)$/);
        if (headingMatch) {
          flushParagraph();
          closeList();
          const heading = document.createElement("h3");
          appendInlineFormatting(heading, headingMatch[1]);
          container.append(heading);
          continue;
        }

        const unorderedMatch = line.match(/^[-*]\s+(.+)$/);
        const orderedMatch = line.match(/^\d+[.)]\s+(.+)$/);
        if (unorderedMatch || orderedMatch) {
          flushParagraph();
          const nextKind = orderedMatch ? "ol" : "ul";
          if (!list || listKind !== nextKind) {
            list = nextKind === "ol" ? document.createElement("ol") : document.createElement("ul");
            listKind = nextKind;
            container.append(list);
          }
          const item = document.createElement("li");
          appendInlineFormatting(item, (orderedMatch || unorderedMatch)[1]);
          list.append(item);
          continue;
        }

        closeList();
        paragraphLines.push(line);
      }

      flushParagraph();
      return container;
    }

    function renderMessage(message) {
      const article = document.createElement("article");
      article.className = `smartbolig-ai__message smartbolig-ai__message--${message.role}`;

      const meta = document.createElement("div");
      meta.className = "smartbolig-ai__message-meta";
      const author = document.createElement("span");
      author.textContent =
        message.role === "assistant" ? root.dataset.labelAssistant || "SmartBolig AI" : root.dataset.labelYou || "You";
      meta.append(author);

      if (message.role === "assistant") {
        const sourceMode = document.createElement("span");
        sourceMode.className = "smartbolig-ai__source-mode";
        const normalizedSourceMode =
          message.sourceMode === "official" ? "official" : message.sourceMode === "mixed" ? "mixed" : "general";
        sourceMode.dataset.sourceMode = normalizedSourceMode;
        sourceMode.textContent =
          normalizedSourceMode === "official"
            ? root.dataset.labelOfficial || "Official sources checked"
            : normalizedSourceMode === "mixed"
            ? root.dataset.labelMixed || "SmartBolig sources + broad AI knowledge"
            : root.dataset.labelGeneral || "General AI knowledge";
        meta.append(sourceMode);
      }

      const bubble = document.createElement("div");
      bubble.className = "smartbolig-ai__bubble";
      if (message.role === "assistant") {
        bubble.append(createSafeRichText(message.content));
      } else {
        const body = document.createElement("p");
        body.append(document.createTextNode(message.content));
        bubble.append(body);
      }

      if (message.role === "assistant") {
        const validSources = Array.isArray(message.sources)
          ? message.sources.map(createSafeSourceLink).filter(Boolean)
          : [];
        if (validSources.length > 0) {
          const sourceBlock = document.createElement("div");
          sourceBlock.className = "smartbolig-ai__sources";
          const sourceLabel = document.createElement("span");
          sourceLabel.textContent = root.dataset.labelSources || "SmartBolig sources";
          sourceBlock.append(sourceLabel, ...validSources);
          bubble.append(sourceBlock);
        }

        const actions = document.createElement("div");
        actions.className = "smartbolig-ai__message-actions";
        actions.append(createCopyButton(message.content));
        bubble.append(actions);
      }

      article.append(meta, bubble);
      return article;
    }

    function renderLoading() {
      const article = document.createElement("article");
      article.className = "smartbolig-ai__message smartbolig-ai__message--assistant smartbolig-ai__message--loading";
      article.setAttribute("aria-label", locale === "en" ? "SmartBolig AI is thinking" : "SmartBolig AI tænker");

      const meta = document.createElement("div");
      meta.className = "smartbolig-ai__message-meta";
      meta.textContent = root.dataset.labelAssistant || "SmartBolig AI";

      const bubble = document.createElement("div");
      bubble.className = "smartbolig-ai__bubble";
      const dots = document.createElement("span");
      dots.className = "smartbolig-ai__typing";
      dots.append(document.createElement("i"), document.createElement("i"), document.createElement("i"));
      bubble.append(dots);
      article.append(meta, bubble);
      messagesElement.append(article);
    }

    function renderError(message) {
      const error = document.createElement("div");
      error.className = "smartbolig-ai__error";
      error.setAttribute("role", "alert");
      const text = document.createElement("p");
      text.textContent = message;
      const retry = document.createElement("button");
      retry.type = "button";
      retry.textContent = root.dataset.labelRetry || "Try again";
      retry.addEventListener("click", () => {
        if (history.at(-1)?.role === "user") sendQuestion(history.at(-1).content, true);
      });
      error.append(text, retry);
      messagesElement.append(error);
    }

    function renderHistory() {
      messagesElement.replaceChildren();
      for (const message of history) {
        messagesElement.append(renderMessage(message));
      }
      const hasMessages = history.length > 0;
      welcome.hidden = hasMessages;
      prompts.hidden = hasMessages;
      messagesElement.hidden = !hasMessages;
      requestAnimationFrame(() => {
        const conversation = root.querySelector("[data-chat-conversation]");
        if (conversation instanceof HTMLElement) conversation.scrollTop = conversation.scrollHeight;
      });
    }

    function setBusy(value) {
      isSending = value;
      panel.setAttribute("aria-busy", value ? "true" : "false");
      input.disabled = value;
      sendButton.disabled = value;
      sendButton.querySelector("span").textContent = value
        ? locale === "en"
          ? "Thinking"
          : "Tænker"
        : locale === "en"
          ? "Send"
          : "Send";
    }

    function openAssistant() {
      panel.hidden = false;
      launcher.setAttribute("aria-expanded", "true");
      root.classList.add("is-open");
      requestAnimationFrame(() => input.focus());
    }

    function closeAssistant() {
      panel.hidden = true;
      launcher.setAttribute("aria-expanded", "false");
      root.classList.remove("is-open");
      launcher.focus();
    }

    function resetConversation() {
      requestSequence += 1;
      const controllerToAbort = abortController;
      abortController = null;
      controllerToAbort?.abort();
      history = [];
      lastFailed = false;
      saveHistory();
      setBusy(false);
      renderHistory();
      setStatus(root.dataset.labelReset || "Conversation cleared.");
      input.value = "";
      input.focus();
    }

    function messageForFailure(code, statusCode, wasAborted) {
      if (wasAborted) return root.dataset.errorTimeout || "The response timed out.";
      if (statusCode === 429 || code === "rate_limited") {
        return root.dataset.errorRate || "Rate limited.";
      }
      if (statusCode === 503 || code === "service_unavailable") {
        return root.dataset.errorService || "Service unavailable.";
      }
      return root.dataset.errorGeneric || "The assistant could not answer.";
    }

    async function sendQuestion(content, reuseExistingUser = false) {
      const question = typeof content === "string" ? content.trim().slice(0, MAX_MESSAGE_CHARS) : "";
      if (!question || isSending) return;
      const requestId = ++requestSequence;

      if (!reuseExistingUser) {
        if (history.at(-1)?.role === "user") history.pop();
        while (history.length >= MAX_HISTORY_MESSAGES) history.splice(0, 2);
        history.push({ role: "user", content: question });
      }
      lastFailed = false;
      saveHistory();
      renderHistory();
      messagesElement.hidden = false;
      renderLoading();
      setBusy(true);
      setStatus(locale === "en" ? "Working on your answer …" : "Arbejder på dit svar …");
      input.value = "";

      abortController?.abort();
      const requestController = new AbortController();
      abortController = requestController;
      const timeout = setTimeout(() => requestController.abort(), REQUEST_TIMEOUT_MS);
      let response;

      try {
        response = await fetch("/api/chat", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            locale,
            messages: history.map(({ role, content: messageContent }) => ({ role, content: messageContent })),
          }),
          signal: requestController.signal,
        });
        const result = await response.json().catch(() => ({}));
        if (requestId !== requestSequence) return;
        if (!response.ok || typeof result.answer !== "string" || !result.answer.trim()) {
          const requestError = new Error("AssistantRequestFailed");
          requestError.code = result.code;
          requestError.statusCode = response.status;
          throw requestError;
        }

        const sources = Array.isArray(result.sources) ? result.sources.slice(0, 5) : [];
        history.push({
          role: "assistant",
          content: result.answer.trim().slice(0, 12_000),
          sourceMode:
            result.sourceMode === "official" ? "official" : result.sourceMode === "mixed" ? "mixed" : "general",
          sources,
        });
        history = history.slice(-MAX_HISTORY_MESSAGES);
        saveHistory();
        renderHistory();
        setStatus(root.dataset.labelReady || "Ready.");
      } catch (error) {
        if (requestId !== requestSequence) return;
        lastFailed = true;
        renderHistory();
        const failureMessage = messageForFailure(
          error?.code,
          error?.statusCode,
          error?.name === "AbortError" || requestController.signal.aborted,
        );
        renderError(failureMessage);
        setStatus(failureMessage);
      } finally {
        clearTimeout(timeout);
        if (abortController === requestController) {
          abortController = null;
          setBusy(false);
          if (!lastFailed) input.focus();
        }
      }
    }

    launcher.addEventListener("click", () => {
      if (panel.hidden) openAssistant();
      else closeAssistant();
    });
    closeButton.addEventListener("click", closeAssistant);
    resetButton.addEventListener("click", resetConversation);

    for (const button of promptButtons) {
      button.addEventListener("click", () => {
        if (!(button instanceof HTMLButtonElement)) return;
        input.value = button.dataset.prompt || "";
        input.focus();
        input.dispatchEvent(new Event("input"));
      });
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      sendQuestion(input.value);
    });
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });
    input.addEventListener("input", () => {
      input.style.height = "auto";
      input.style.height = `${Math.min(input.scrollHeight, 128)}px`;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) closeAssistant();
    });

    renderHistory();
  }

  function initSmartboligAssistants() {
    document.querySelectorAll("[data-smartbolig-ai]").forEach(setupAssistant);
  }

  initSmartboligAssistants();
  document.addEventListener("astro:page-load", initSmartboligAssistants);
</script>

