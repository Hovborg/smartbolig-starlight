---
// Entry for the SmartBolig AI chat widget. Markup parts live in ./assistant/,
// client logic in src/scripts/assistant/, copy in src/lib/assistant-copy.ts.
import { assistantCopy } from '../lib/assistant-copy';
import AssistantComposer from './assistant/AssistantComposer.astro';
import AssistantConversation from './assistant/AssistantConversation.astro';
import AssistantHeader from './assistant/AssistantHeader.astro';
import AssistantLauncher from './assistant/AssistantLauncher.astro';
import AssistantPanel from './assistant/AssistantPanel.astro';
import AssistantSystemBar from './assistant/AssistantSystemBar.astro';
import AssistantFeedbackStyles from './assistant/AssistantFeedbackStyles.astro';
import AssistantMessageStyles from './assistant/AssistantMessageStyles.astro';
import AssistantMetaStyles from './assistant/AssistantMetaStyles.astro';
import AssistantRichTextStyles from './assistant/AssistantRichTextStyles.astro';

interface Props {
  locale?: string;
}

const { locale = 'da' } = Astro.props;
const lang = locale === 'en' ? 'en' : 'da';
const t = assistantCopy[lang];
---

<div
  class="smartbolig-ai"
  data-smartbolig-ai
  data-locale={lang}
  data-label-assistant={t.assistant}
  data-label-you={t.you}
  data-label-copy={t.copy}
  data-label-copy-code={t.copyCode}
  data-label-copied={t.copied}
  data-label-code={t.code}
  data-label-retry={t.retry}
  data-label-ready={t.ready}
  data-label-reset={t.resetDone}
  data-label-general={t.general}
  data-label-mixed={t.mixed}
  data-label-official={t.official}
  data-label-sources={t.sources}
  data-label-diagnostic-model={t.diagnosticModel}
  data-label-diagnostic-route={t.diagnosticRoute}
  data-label-diagnostic-edge={t.diagnosticEdge}
  data-label-diagnostic-trace={t.diagnosticTrace}
  data-label-diagnostic-sources={t.diagnosticSources}
  data-label-edge-active={t.edgeActive}
  data-label-edge-pipeline={t.edgePipeline}
  data-label-mode-truncated={t.modeTruncated}
  data-label-route-primary={t.routePrimary}
  data-label-route-fallback={t.routeFallback}
  data-label-route-unknown={t.routeUnknown}
  data-label-model-unknown={t.modelUnknown}
  data-error-rate={t.errorRate}
  data-error-service={t.errorService}
  data-error-timeout={t.errorTimeout}
  data-error-generic={t.errorGeneric}
>
  <AssistantLauncher t={t} />
  <AssistantPanel>
    <AssistantHeader t={t} />
    <AssistantSystemBar t={t} />
    <AssistantConversation t={t} />
    <AssistantComposer t={t} />
  </AssistantPanel>
</div>

<AssistantMessageStyles />
<AssistantMetaStyles />
<AssistantRichTextStyles />
<AssistantFeedbackStyles />

<script>
  import '../scripts/assistant/index';
</script>

<style is:global>
  .smartbolig-ai {
    --ai-signal: var(--sb-accent);
    --ai-signal-strong: var(--sb-accent-strong);
    --ai-glow: var(--sb-accent-vivid);
    --ai-surface: color-mix(in srgb, var(--sb-surface) 96%, transparent);
    --ai-surface-soft: var(--sb-bg-subtle);
    --ai-grid: color-mix(in srgb, var(--sb-accent) 7%, transparent);
    --ai-line: var(--sb-line);
    --ai-line-strong: var(--sb-line-strong);
    --ai-text: var(--sb-ink);
    --ai-text-strong: var(--sb-ink-strong);
    --ai-muted: var(--sb-ink-muted);
    --ai-dim: var(--sb-ink-subtle);
    --ai-user: var(--sb-accent-soft);
    position: fixed;
    z-index: 10000;
    right: max(1.25rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    color: var(--ai-text);
    font-family: var(--sb-font-body);
  }

  .smartbolig-ai *,
  .smartbolig-ai *::before,
  .smartbolig-ai *::after {
    box-sizing: border-box;
  }

  .smartbolig-ai button,
  .smartbolig-ai textarea {
    font: inherit;
  }

  .smartbolig-ai__launcher:focus-visible,
  .smartbolig-ai button:focus-visible,
  .smartbolig-ai textarea:focus-visible,
  .smartbolig-ai a:focus-visible {
    outline: 3px solid var(--ai-signal);
    outline-offset: 3px;
  }

  .smartbolig-ai__status-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--sb-radius-pill);
    background: var(--ai-glow);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
    margin: -1px;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .smartbolig-ai {
      inset-inline: 0;
      right: auto;
      bottom: 0;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .smartbolig-ai * {
      scroll-behavior: auto;
    }
  }
</style>
