---
// Work-mode buttons, the message form and the privacy/status line.
import type { AssistantCopy } from '../../lib/assistant-copy';

interface Props {
  t: AssistantCopy;
}

const { t } = Astro.props;
---

<div class="smartbolig-ai__composer">
  <div class="smartbolig-ai__modes" role="group" aria-label={t.workModeLabel} data-chat-modes>
    <span class="smartbolig-ai__modes-label">{t.workMode}</span>
    <button type="button" data-chat-mode data-template={t.modeDebugTemplate} aria-pressed="false">
      <small>DBG</small><strong>{t.modeDebug}</strong>
    </button>
    <button type="button" data-chat-mode data-template={t.modeBuildTemplate} aria-pressed="false">
      <small>BLD</small><strong>{t.modeBuild}</strong>
    </button>
    <button type="button" data-chat-mode data-template={t.modeExplainTemplate} aria-pressed="false">
      <small>EXP</small><strong>{t.modeExplain}</strong>
    </button>
    <button type="button" data-chat-mode data-template={t.modeCompareTemplate} aria-pressed="false">
      <small>CMP</small><strong>{t.modeCompare}</strong>
    </button>
  </div>
  <form data-chat-form>
    <label class="sr-only" for="smartbolig-ai-input">{t.placeholder}</label>
    <span class="smartbolig-ai__command-prompt" aria-hidden="true">&gt;_</span>
    <textarea
      id="smartbolig-ai-input"
      rows="1"
      maxlength="2000"
      enterkeyhint="send"
      placeholder={t.placeholder}
      data-chat-input
    ></textarea>
    <button class="smartbolig-ai__send" type="submit" aria-label={t.send} data-chat-send>
      <span>{t.send}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m5 12 14-7-4.5 14-3-5.5L5 12Z"></path>
        <path d="m11.5 13.5 3-3"></path>
      </svg>
    </button>
  </form>
  <div class="smartbolig-ai__composer-meta">
    <p>{t.privacy}</p>
    <span role="status" aria-live="polite" data-chat-status>{t.ready}</span>
  </div>
</div>

<style>
  .smartbolig-ai__composer {
    padding: 0.72rem 0.85rem 0.7rem;
    border-top: 1px solid var(--ai-line);
    background: color-mix(in srgb, var(--sb-bg-subtle) 90%, transparent);
  }

  .smartbolig-ai__modes {
    display: flex;
    min-width: 0;
    gap: 0.34rem;
    align-items: center;
    margin: 0 0 0.52rem;
    overflow-x: auto;
    scrollbar-color: color-mix(in srgb, var(--sb-ink-subtle) 40%, transparent) transparent;
    scrollbar-width: thin;
  }

  .smartbolig-ai__modes-label {
    flex: 0 0 auto;
    margin-right: 0.08rem;
    color: var(--ai-dim);
    font-family: var(--sb-font-mono);
    font-size: 0.45rem;
    font-weight: 760;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .smartbolig-ai__modes button {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: baseline;
    gap: 0.27rem;
    min-height: 25px;
    padding: 0.26rem 0.42rem;
    border: 1px solid var(--ai-line);
    border-radius: var(--sb-radius-sm);
    color: var(--ai-muted);
    background: var(--sb-surface);
    cursor: pointer;
  }

  .smartbolig-ai__modes button small {
    color: var(--ai-dim);
    font-family: var(--sb-font-mono);
    font-size: 0.4rem;
    font-weight: 780;
    letter-spacing: 0.06em;
  }

  .smartbolig-ai__modes button strong {
    font-size: 0.56rem;
    font-weight: 690;
    white-space: nowrap;
  }

  .smartbolig-ai__modes button:hover,
  .smartbolig-ai__modes button[aria-pressed='true'] {
    border-color: color-mix(in srgb, var(--ai-signal) 38%, transparent);
    color: var(--sb-accent-strong);
    background: var(--sb-accent-soft);
  }

  .smartbolig-ai__modes button:hover small,
  .smartbolig-ai__modes button[aria-pressed='true'] small {
    color: var(--sb-accent-strong);
  }

  .smartbolig-ai__modes button:disabled {
    cursor: wait;
    opacity: 0.5;
  }

  .smartbolig-ai__composer form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.34rem 0.36rem 0.34rem 0.68rem;
    border: 1px solid var(--ai-line-strong);
    border-radius: var(--sb-radius-md);
    background: var(--sb-surface);
  }

  .smartbolig-ai__composer form:focus-within {
    border-color: var(--ai-signal);
  }

  .smartbolig-ai__command-prompt {
    align-self: flex-start;
    padding-top: 0.77rem;
    color: var(--ai-signal);
    font-family: var(--sb-font-mono);
    font-size: 0.62rem;
    font-weight: 760;
  }

  .smartbolig-ai__composer textarea {
    width: 100%;
    max-height: 128px;
    min-height: 42px;
    padding: 0.62rem 0;
    resize: none;
    overflow-y: auto;
    border: 0;
    outline: 0;
    color: var(--ai-text);
    background: transparent;
    font-size: 0.77rem;
    line-height: 1.4;
  }

  .smartbolig-ai__composer textarea::placeholder {
    color: var(--ai-dim);
  }

  .smartbolig-ai__composer textarea:focus-visible {
    outline: 0;
  }

  .smartbolig-ai__send {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 40px;
    padding: 0 0.7rem;
    border: 1px solid color-mix(in srgb, var(--ai-signal) 42%, transparent);
    border-radius: var(--sb-radius-sm);
    color: var(--sb-on-accent);
    background: linear-gradient(135deg, var(--sb-accent), var(--sb-accent-strong));
    box-shadow: var(--sb-shadow-sm);
    cursor: pointer;
    font-size: 0.69rem;
    font-weight: 750;
  }

  .smartbolig-ai__send:disabled {
    cursor: wait;
    filter: saturate(0.6);
    opacity: 0.65;
  }

  .smartbolig-ai__send svg {
    width: 15px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .smartbolig-ai__composer-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.42rem 0.15rem 0;
    color: var(--ai-dim);
    font-size: 0.54rem;
    line-height: 1.3;
  }

  .smartbolig-ai__composer-meta p {
    max-width: 56%;
    margin: 0;
  }

  .smartbolig-ai__composer-meta [role="status"] {
    overflow: hidden;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .smartbolig-ai__modes button {
      transition:
        border-color var(--sb-dur-fast) var(--sb-ease),
        color var(--sb-dur-fast) var(--sb-ease),
        background var(--sb-dur-fast) var(--sb-ease);
    }

    .smartbolig-ai__composer form {
      transition: border-color var(--sb-dur-fast) var(--sb-ease);
    }
  }
</style>
