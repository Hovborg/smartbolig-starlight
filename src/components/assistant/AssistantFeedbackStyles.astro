---
// Styles for the answer on its way (status line, loading console) and for the
// error and stop notices. Global: the client script creates these nodes.
---

<style is:global>
  .smartbolig-ai__typing {
    display: inline-flex;
    grid-area: dots;
    gap: 0.28rem;
    justify-self: end;
    padding: 0.05rem 0;
  }

  .smartbolig-ai__typing i {
    width: 6px;
    height: 6px;
    border-radius: var(--sb-radius-pill);
    background: var(--ai-glow);
  }

  .smartbolig-ai__loading-console {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "stage stage"
      "head head"
      "signal signal"
      "pipeline dots";
    gap: 0.42rem 0.8rem;
    min-width: 0;
    font-family: var(--sb-font-mono);
  }

  /* What happens right now, in plain words. The mono lines under it are the console's own. */
  .smartbolig-ai__loading-console .smartbolig-ai__loading-stage {
    grid-area: stage;
    color: var(--ai-text-strong);
    font-family: var(--sb-font-body);
    font-size: var(--sb-text-sm);
    font-weight: 650;
    line-height: 1.4;
    white-space: normal;
  }

  /* The draft grows where the reader is looking. With scroll anchoring the
     browser would hold on to the sources below it and push the text off the top. */
  .smartbolig-ai__message--loading {
    overflow-anchor: none;
  }

  /* An empty draft takes no room: the first words decide when it appears. */
  .smartbolig-ai__rich-text[hidden] {
    display: none;
  }

  /* While the answer is written the console is one quiet line under the text. */
  .smartbolig-ai__message--loading[data-has-text] .smartbolig-ai__loading-console {
    grid-template-areas:
      "signal signal"
      "stage head";
    align-items: center;
    margin-top: 0.75rem;
  }

  .smartbolig-ai__message--loading[data-has-text] .smartbolig-ai__loading-stage {
    color: var(--ai-muted);
    font-size: var(--sb-text-xs);
    font-weight: 600;
  }

  .smartbolig-ai__message--loading[data-has-text] .smartbolig-ai__loading-head span,
  .smartbolig-ai__message--loading[data-has-text] .smartbolig-ai__loading-console > small,
  .smartbolig-ai__message--loading[data-has-text] .smartbolig-ai__typing {
    display: none;
  }

  .smartbolig-ai__loading-head {
    display: flex;
    grid-area: head;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    color: var(--ai-signal);
    font-size: var(--sb-text-xs);
    font-weight: 760;
    letter-spacing: 0.05em;
  }

  .smartbolig-ai__loading-head span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .smartbolig-ai__loading-head strong {
    flex: 0 0 auto;
    color: var(--ai-signal);
    font-size: var(--sb-text-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .smartbolig-ai__loading-signal {
    position: relative;
    grid-area: signal;
    height: 2px;
    overflow: hidden;
    border-radius: var(--sb-radius-pill);
    background: color-mix(in srgb, var(--ai-signal) 14%, transparent);
  }

  .smartbolig-ai__loading-signal i {
    position: absolute;
    inset-block: 0;
    left: -34%;
    width: 34%;
    border-radius: inherit;
    background: linear-gradient(90deg, transparent, var(--ai-glow), var(--ai-signal));
  }

  .smartbolig-ai__loading-console > small {
    grid-area: pipeline;
    align-self: center;
    overflow: hidden;
    color: var(--ai-dim);
    font-size: var(--sb-text-xs);
    font-weight: 680;
    letter-spacing: 0.04em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .smartbolig-ai__error {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    padding: 0.72rem;
    border: 1px solid color-mix(in srgb, var(--sb-danger) 35%, transparent);
    border-radius: var(--sb-radius-md);
    color: var(--sb-danger);
    background: var(--sb-danger-soft);
    font-size: var(--sb-text-sm);
    line-height: 1.4;
  }

  .smartbolig-ai__error p {
    margin: 0;
  }

  .smartbolig-ai__error button {
    flex: 0 0 auto;
    padding: 0.36rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--sb-danger) 45%, transparent);
    border-radius: var(--sb-radius-sm);
    color: var(--sb-danger);
    background: transparent;
    cursor: pointer;
    font-size: var(--sb-text-xs);
  }

  @media (max-width: 640px) {
    .smartbolig-ai__error button {
      min-height: 40px;
      padding-inline: 0.8rem;
    }
  }

  .smartbolig-ai__error button:hover {
    background: color-mix(in srgb, var(--sb-danger) 12%, transparent);
  }

  /* The reader stopped the answer themselves: a note, not a warning. */
  .smartbolig-ai__error--quiet {
    border-color: var(--ai-line);
    color: var(--ai-muted);
    background: var(--ai-surface-soft);
  }

  .smartbolig-ai__error--quiet button {
    border-color: var(--ai-line-strong);
    color: var(--ai-text);
  }

  .smartbolig-ai__error--quiet button:hover {
    background: var(--sb-accent-soft);
  }

  @media (prefers-reduced-motion: no-preference) {
    .smartbolig-ai__typing i {
      animation: smartbolig-ai-typing 1s ease-in-out infinite;
    }

    .smartbolig-ai__typing i:nth-child(2) {
      animation-delay: 130ms;
    }

    .smartbolig-ai__typing i:nth-child(3) {
      animation-delay: 260ms;
    }

    .smartbolig-ai__loading-signal i {
      animation: smartbolig-ai-edge-scan 1.35s ease-in-out infinite;
    }
  }

  @keyframes smartbolig-ai-typing {
    0%,
    80%,
    100% {
      opacity: 0.4;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  @keyframes smartbolig-ai-edge-scan {
    0% {
      left: -34%;
    }
    100% {
      left: 100%;
    }
  }
</style>
