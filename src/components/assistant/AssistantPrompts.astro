---
// Four starter prompts shown before the first message.
import type { AssistantCopy } from '../../lib/assistant-copy';

interface Props {
  t: AssistantCopy;
}

const { t } = Astro.props;
---

<div class="smartbolig-ai__prompts" data-chat-prompts>
  <p>{t.suggestions}</p>
  <button type="button" data-chat-prompt data-prompt={t.prompt1}>
    <span class="smartbolig-ai__prompt-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M4 18h4l2-12 4 12 2-8 2 8h2"></path></svg>
    </span>
    <span class="smartbolig-ai__prompt-copy"><small>{t.prompt1Meta}</small><strong>{t.prompt1}</strong></span>
    <span class="smartbolig-ai__prompt-arrow" aria-hidden="true">↗</span>
  </button>
  <button type="button" data-chat-prompt data-prompt={t.prompt2}>
    <span class="smartbolig-ai__prompt-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"></rect><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"></path></svg>
    </span>
    <span class="smartbolig-ai__prompt-copy"><small>{t.prompt2Meta}</small><strong>{t.prompt2}</strong></span>
    <span class="smartbolig-ai__prompt-arrow" aria-hidden="true">↗</span>
  </button>
  <button type="button" data-chat-prompt data-prompt={t.prompt3}>
    <span class="smartbolig-ai__prompt-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M5 8a10 10 0 0 1 14 0M8 11a6 6 0 0 1 8 0M10.5 14a2.5 2.5 0 0 1 3 0"></path><circle cx="12" cy="18" r="1"></circle></svg>
    </span>
    <span class="smartbolig-ai__prompt-copy"><small>{t.prompt3Meta}</small><strong>{t.prompt3}</strong></span>
    <span class="smartbolig-ai__prompt-arrow" aria-hidden="true">↗</span>
  </button>
  <button type="button" data-chat-prompt data-prompt={t.prompt4}>
    <span class="smartbolig-ai__prompt-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="6" rx="2"></rect><rect x="4" y="14" width="16" height="6" rx="2"></rect><path d="M8 7h.01M8 17h.01M12 7h5M12 17h5"></path></svg>
    </span>
    <span class="smartbolig-ai__prompt-copy"><small>{t.prompt4Meta}</small><strong>{t.prompt4}</strong></span>
    <span class="smartbolig-ai__prompt-arrow" aria-hidden="true">↗</span>
  </button>
</div>

<style>
  .smartbolig-ai__prompts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .smartbolig-ai__prompts[hidden] {
    display: none;
  }

  .smartbolig-ai__prompts > p {
    grid-column: 1 / -1;
    margin: 0.18rem 0 0;
    color: var(--ai-dim);
    font-family: var(--sb-font-mono);
    font-size: 0.57rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .smartbolig-ai__prompts button {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.52rem;
    width: 100%;
    min-height: 82px;
    padding: 0.7rem 0.62rem;
    overflow: hidden;
    border: 1px solid var(--ai-line);
    border-radius: var(--sb-radius-md);
    color: var(--ai-text);
    background: var(--ai-surface-soft);
    cursor: pointer;
    text-align: left;
  }

  .smartbolig-ai__prompts button:hover {
    color: var(--ai-text-strong);
    border-color: color-mix(in srgb, var(--ai-signal) 40%, transparent);
    background: var(--sb-accent-soft);
    box-shadow: var(--sb-shadow-md);
  }

  .smartbolig-ai__prompt-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid color-mix(in srgb, var(--ai-signal) 18%, transparent);
    border-radius: var(--sb-radius-sm);
    color: var(--ai-signal);
    background: color-mix(in srgb, var(--ai-signal) 6%, transparent);
  }

  .smartbolig-ai__prompt-icon svg {
    width: 16px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .smartbolig-ai__prompt-copy {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .smartbolig-ai__prompt-copy small {
    color: var(--ai-signal);
    font-family: var(--sb-font-mono);
    font-size: 0.47rem;
    font-weight: 700;
    letter-spacing: 0.09em;
  }

  .smartbolig-ai__prompts button:hover .smartbolig-ai__prompt-copy small {
    color: var(--ai-signal-strong);
  }

  .smartbolig-ai__prompt-copy strong {
    color: inherit;
    font-size: 0.67rem;
    font-weight: 620;
    line-height: 1.35;
  }

  .smartbolig-ai__prompt-arrow {
    color: var(--ai-dim);
    font-size: 0.72rem;
  }

  .smartbolig-ai__prompts button:hover .smartbolig-ai__prompt-arrow {
    color: var(--ai-signal-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .smartbolig-ai__prompts button {
      transition:
        transform var(--sb-dur-fast) var(--sb-ease),
        color var(--sb-dur-fast) var(--sb-ease),
        border-color var(--sb-dur-fast) var(--sb-ease),
        background var(--sb-dur-fast) var(--sb-ease);
    }

    .smartbolig-ai__prompt-arrow {
      transition:
        color var(--sb-dur-fast) var(--sb-ease),
        transform var(--sb-dur-fast) var(--sb-ease);
    }

    .smartbolig-ai__prompts button:hover {
      transform: translateY(-2px);
    }

    .smartbolig-ai__prompts button:hover .smartbolig-ai__prompt-arrow {
      transform: translate(1px, -1px);
    }
  }
</style>
