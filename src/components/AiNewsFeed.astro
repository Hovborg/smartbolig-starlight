---
/**
 * AI-news overview for the news index pages (da/en `ai/nyheder/index.mdx`).
 * Thin entry: selection lives in src/lib/ai-news-feed.ts, copy in
 * src/lib/ai-news-copy.ts, the parts in src/components/ai-news/.
 */
import { getCollection } from "astro:content";
import { aiNewsCopy } from "../lib/ai-news-copy";
import { groupByMonth, selectIssues } from "../lib/ai-news-feed";
import { totalSourceCount } from "../lib/ai-news-sources";
import type { NewsLocale } from "../lib/home-news";
import FeedStats from "./ai-news/FeedStats.astro";
import LatestIssue from "./ai-news/LatestIssue.astro";
import ArchiveList from "./ai-news/ArchiveList.astro";
import SourcePanel from "./ai-news/SourcePanel.astro";
import "./ai-news/panel.css";

interface Props {
  locale?: NewsLocale;
}

const locale: NewsLocale = Astro.props.locale === "en" ? "en" : "da";
const rssHref = locale === "da" ? "/da/ai/nyheder/rss.xml" : "/en/ai/news/rss.xml";
const copy = aiNewsCopy[locale];

const issues = selectIssues(await getCollection("docs"), locale);
const [latest, ...earlier] = issues;
---

<section class="ai-news-feed not-content" aria-label={copy.feed}>
  <FeedStats copy={copy} issueCount={issues.length} totalSourceCount={totalSourceCount} rssHref={rssHref} />

  {latest ? <LatestIssue issue={latest} copy={copy} locale={locale} /> : <p class="empty-feed">{copy.noIssues}</p>}

  {earlier.length > 0 && <ArchiveList months={groupByMonth(earlier, locale)} copy={copy} locale={locale} />}

  <SourcePanel copy={copy} />
</section>

<style>
  .ai-news-feed {
    display: grid;
    gap: var(--sb-space-6);
    margin-top: var(--sb-space-5);
  }
</style>
