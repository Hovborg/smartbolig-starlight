---
// The three newest AI news articles as a compact list. The articles come from
// the same selection as the news overview (ai-news-feed.ts); each row is named
// after its main story, since the date already stands beside it.
import { getCollection } from "astro:content";
import { formatDate, selectIssues } from "../lib/ai-news-feed";
import type { NewsLocale } from "../lib/home-news";

interface Props {
  locale: NewsLocale;
}

const { locale } = Astro.props;
const isDa = locale === "da";
const docs = await getCollection("docs");
const latest = selectIssues(docs, locale).slice(0, 3);
const archiveHref = isDa ? "/da/ai/nyheder/" : "/en/ai/nyheder/";
const rssHref = isDa ? "/da/ai/nyheder/rss.xml" : "/en/ai/news/rss.xml";
const copy = isDa
  ? {
      archive: "Alle AI-nyheder",
      rss: "Følg via RSS",
      empty: "Der er ingen publicerede AI-nyheder endnu.",
    }
  : {
      archive: "All AI news",
      rss: "Follow via RSS",
      empty: "There are no published AI news articles yet.",
    };

// ai-news-thumbs.mjs renders a 320x180 WebP next to every base hero at build
// time, so the 160x90 list thumb never loads the full 1200x630 hero image.
const thumbSrc = (src: string) => src.replace(/\.(?:jpg|png)$/, "-thumb.webp");
---

<div class="home-latest-news">
  {
    latest.length > 0 ? (
      <ul class="home-news-list">
        {latest.map((item) => (
          <li class="home-news-row">
            <time datetime={item.dateString}>{formatDate(item.date, locale)}</time>
            <div class="home-news-row__text">
              <h3><a href={item.href}>{item.lead}</a></h3>
              <p>{item.description}</p>
            </div>
            {item.image && (
              <img
                class="home-news-row__thumb"
                src={thumbSrc(item.image.src)}
                alt=""
                width="160"
                height="90"
                loading="lazy"
                decoding="async"
              />
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="home-news-empty">{copy.empty}</p>
    )
  }
  <div class="home-news-actions">
    <a href={archiveHref}>{copy.archive}</a>
    <a href={rssHref}>{copy.rss}</a>
  </div>
</div>
