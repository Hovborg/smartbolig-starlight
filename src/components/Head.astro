---
import Default from "@astrojs/starlight/components/Head.astro";
import { Font, fontData } from "astro:assets";
import { getAiNewsAssets } from "../lib/seo/ai-news";
import { getPageDates } from "../lib/seo/dates";
import { getPageKind } from "../lib/seo/page-kind";
import { getRobotsContent, getTitleAndDescription } from "../lib/seo/page-text";
import { buildSchemaJson } from "../lib/seo/schema-graph";
import { applySocialMeta, type HeadEntry } from "../lib/seo/social-meta";

const pathname = Astro.url.pathname;
const kind = getPageKind(pathname);
const { lang } = kind;

let starlightRoute: typeof Astro.locals.starlightRoute | null = null;

try {
  starlightRoute = Astro.locals.starlightRoute;
} catch {
  starlightRoute = null;
}

// Get page data with fallbacks for 404 page and custom Starlight head props.
const entry = Astro.props.entry || starlightRoute?.entry;
const lastUpdated = Astro.props.lastUpdated || starlightRoute?.lastUpdated;
const { title, description } = getTitleAndDescription(entry, lang, kind.isNotFoundPage);
const { dateModified, datePublished } = getPageDates(entry, lastUpdated);
const aiNews = getAiNewsAssets(entry, lang, kind.isAiNewsArticle);
const robotsContent = getRobotsContent(kind.isNotFoundPage);

// Mutates Starlight's head list before <Default> renders it.
applySocialMeta({
  head: (starlightRoute?.head ?? []) as HeadEntry[],
  kind,
  entry,
  title,
  description,
  aiNews,
  dateModified,
  datePublished,
});

const combinedSchemaJson = buildSchemaJson({ pathname, entry, lastUpdated, aiNews });

const latinFontUrls = ["--font-body", "--font-display"]
  .map((cssVariable) => fontData[cssVariable as keyof typeof fontData]?.[0]?.src[0]?.url)
  .filter((url): url is string => Boolean(url));
---
<Default {...Astro.props} />

<!-- Self-hosted fonts (config/fonts.mjs). Only the Latin file of each family is
     preloaded: it is the first variant, and it covers Danish and English. -->
{latinFontUrls.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
<Font cssVariable="--font-body" />
<Font cssVariable="--font-display" />

<!-- Content Protection Meta Tags -->
<meta name="robots" content={robotsContent} />

<!-- Copyright information -->
<meta name="copyright" content="SmartBolig.net" />
<meta name="author" content="SmartBolig.net" />

<script type="application/ld+json" set:html={combinedSchemaJson} />

<!-- Consent first: Google Analytics and AdSense are fetched only after a yes
     in Google's consent message (src/lib/consent/, docs/samtykke.md). -->
<script>
  import { boot } from "../lib/consent/boot.mjs";
  boot();
</script>
