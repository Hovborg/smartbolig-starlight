---
import type { AiNewsCopy } from "../../lib/ai-news-copy";
import type { NewsIssue } from "../../lib/ai-news-feed";
import type { NewsLocale } from "../../lib/home-news";
import IssueMeta from "./IssueMeta.astro";

interface Props {
  issue: NewsIssue;
  copy: AiNewsCopy;
  locale: NewsLocale;
}

const { issue, copy, locale } = Astro.props;
---

<article class="issue-row" role="listitem">
  <div class="issue-row-main">
    <IssueMeta issue={issue} copy={copy} locale={locale} />
    <h3><a href={issue.href}>{issue.title}</a></h3>
    <p>{issue.description}</p>
    {issue.headlines.length > 0 && (
      <ul class="compact-headlines">
        {issue.headlines.slice(0, 4).map((headline) => (
          <li><a href={headline.href}><span>{headline.provider}</span>{" "}{headline.title}</a></li>
        ))}
      </ul>
    )}
  </div>
  <a class="row-link" href={issue.href}>{copy.read}</a>
</article>

<style>
  .issue-row {
    align-items: start;
    border-top: 1px solid var(--sb-line);
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr) auto;
    padding-top: 1rem;
  }

  .issue-row h3,
  .issue-row p {
    margin-bottom: 0;
  }

  .issue-row p {
    color: var(--sb-ink-muted);
  }

  .compact-headlines {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0;
    padding-left: 1.2rem;
  }

  .compact-headlines li,
  .compact-headlines a {
    color: var(--sb-ink);
  }

  .compact-headlines a {
    display: inline;
  }

  .compact-headlines span {
    color: var(--sb-accent);
    font-size: var(--sb-text-xs);
    font-weight: 800;
    margin-right: 0.35rem;
    text-transform: uppercase;
  }

  .row-link {
    border: 1px solid var(--sb-line-strong);
    border-radius: var(--sb-radius-sm);
    color: var(--sb-ink);
    display: inline-flex;
    font-weight: 700;
    line-height: 1;
    padding: 0.7rem 0.9rem;
    text-decoration: none;
  }

  @media (max-width: 46rem) {
    .issue-row {
      grid-template-columns: 1fr;
    }

    .row-link {
      justify-content: center;
      width: 100%;
    }
  }
</style>
