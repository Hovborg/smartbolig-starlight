---
// Date and number of sources for one article. Styled in panel.css.
import type { AiNewsCopy } from "../../lib/ai-news-copy";
import { formatDate, type NewsIssue } from "../../lib/ai-news-feed";
import type { NewsLocale } from "../../lib/home-news";

interface Props {
  issue: Pick<NewsIssue, "date" | "dateString" | "sources" | "providers">;
  copy: AiNewsCopy;
  locale: NewsLocale;
}

const { issue, copy, locale } = Astro.props;
---

<p class="issue-meta">
  <time datetime={issue.dateString}>{formatDate(issue.date, locale)}</time>
  <span aria-hidden="true">·</span>
  <span>{issue.sources.length} {issue.sources.length === 1 ? copy.source : copy.sourcesPlural}</span>
  {
    issue.providers.length > 0 && (
      <>
        <span aria-hidden="true">·</span>
        <span>{issue.providers.join(", ")}</span>
      </>
    )
  }
</p>
