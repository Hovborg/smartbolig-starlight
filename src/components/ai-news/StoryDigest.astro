---
// The stories in the newest article: a numbered list with a link to each
// section and to its original source.
import type { AiNewsCopy } from "../../lib/ai-news-copy";
import type { Headline } from "../../lib/ai-news-feed";

interface Props {
  headlines: Headline[];
  copy: AiNewsCopy;
}

const { headlines, copy } = Astro.props;
---

<div class="story-digest">
  <h3 id="ai-news-top-stories">{copy.topStories}</h3>
  <ol aria-labelledby="ai-news-top-stories">
    {
      headlines.map((headline, index) => (
        <li>
          <span class="story-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <span class="story-provider">{headline.provider}</span>
            <a class="story-title" href={headline.href}>{headline.title}</a>
            {headline.sourceUrl && (
              <a class="story-source" href={headline.sourceUrl}>
                {copy.openSource}: {headline.sourceName}
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .story-digest {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--sb-line);
    background: var(--sb-bg-subtle);
  }

  .story-digest h3 {
    margin: 0 0 var(--sb-space-4);
    color: var(--sb-ink-muted);
    font-family: var(--sb-font-body);
    font-size: var(--sb-text-sm);
    font-weight: 650;
  }

  .story-digest ol {
    display: grid;
    gap: var(--sb-space-4) var(--sb-space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .story-digest li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: var(--sb-space-3);
    align-items: start;
  }

  .story-number {
    padding-top: 0.15rem;
    color: var(--sb-accent);
    font-family: var(--sb-font-display);
    font-size: var(--sb-text-lg);
    font-weight: 700;
    line-height: 1.2;
  }

  .story-provider {
    display: block;
    color: var(--sb-ink-subtle);
    font-size: var(--sb-text-xs);
    font-weight: 650;
  }

  .story-title {
    display: block;
    /* Room above and below: the one-line link is then over the 24 px a pointer target needs. */
    padding-block: var(--sb-space-1);
    color: var(--sb-ink-strong);
    font-weight: 650;
    line-height: 1.4;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .story-title:hover {
    color: var(--sb-accent);
    text-decoration: underline;
  }

  .story-source {
    display: inline-block;
    padding-block: var(--sb-space-1);
    color: var(--sb-ink-muted);
    font-size: var(--sb-text-xs);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.2em;
  }

  .story-source:hover {
    color: var(--sb-accent);
  }

  @media (min-width: 44rem) {
    .story-digest ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
