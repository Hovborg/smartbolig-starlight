---
import type { AiNewsCopy } from "../../lib/ai-news-copy";
import type { NewsIssue } from "../../lib/ai-news-feed";
import type { NewsLocale } from "../../lib/home-news";
import IssueRow from "./IssueRow.astro";

interface Props {
  issues: NewsIssue[];
  copy: AiNewsCopy;
  locale: NewsLocale;
  rssHref: string;
}

const { issues, copy, locale, rssHref } = Astro.props;
---

<div class="archive-panel">
  <div class="section-heading">
    <h2>{copy.archive}</h2>
    <a href={rssHref}>{copy.rss}</a>
  </div>
  <div class="issue-list" role="list">
    {issues.map((issue) => <IssueRow issue={issue} copy={copy} locale={locale} />)}
  </div>
</div>

<style>
  .section-heading {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .section-heading h2 {
    margin-top: 0;
  }

  .issue-list {
    display: grid;
    gap: 0.75rem;
  }
</style>
