---
// Giscus comments component for SmartBolig.net
// Only shows on article pages, not on index/splash pages
import { isArticlePage } from "../lib/article-page.mjs";

const pathname = Astro.url.pathname;
const locale = Astro.currentLocale || (pathname.startsWith('/en/') ? 'en' : 'da');
const copy = {
  da: {
    title: "Kommentarer",
    show: "Vis kommentarer",
    note: "Kommentarerne hentes fra giscus.app og GitHub, når du trykker.",
    loading: "Henter kommentarerne …",
    failed: "Kommentarerne kunne ikke hentes. Prøv igen.",
  },
  en: {
    title: "Comments",
    show: "Show comments",
    note: "The comments are fetched from giscus.app and GitHub when you press the button.",
    loading: "Fetching the comments …",
    failed: "The comments could not be fetched. Try again.",
  },
}[locale === "en" ? "en" : "da"];

// Comments only under a guide or a news article.
const showComments = isArticlePage(pathname);
---

{showComments && (
  <div class="giscus-wrapper" data-giscus-lang={locale} data-giscus-loading={copy.loading} data-giscus-failed={copy.failed} data-pagefind-ignore>
    <hr class="giscus-divider" />
    <h2 class="giscus-title" tabindex="-1">{copy.title}</h2>
    <div class="giscus-ask" data-giscus-ask>
      <button type="button" data-giscus-show>{copy.show}</button>
      <p role="status" data-giscus-note>{copy.note}</p>
    </div>
  </div>
)}

<script>
  // Nothing is fetched from giscus.app until the visitor asks (src/lib/comments.mjs).
  import { loadComments } from "../lib/comments.mjs";

  const wrapper = document.querySelector<HTMLElement>(".giscus-wrapper");
  const ask = wrapper?.querySelector<HTMLElement>("[data-giscus-ask]");
  const button = ask?.querySelector<HTMLButtonElement>("[data-giscus-show]");
  const note = ask?.querySelector<HTMLElement>("[data-giscus-note]");
  if (wrapper && ask && button && note) {
    const tell = (text = "") => (note.textContent = text);
    // The button stays in place while the widget is fetched, so keyboard focus is not lost.
    const shown = () => {
      const hadFocus = ask.contains(document.activeElement);
      ask.remove();
      if (hadFocus) wrapper.querySelector<HTMLElement>(".giscus-title")?.focus();
    };
    const failed = () => {
      button.setAttribute("aria-disabled", "false");
      tell(wrapper.dataset.giscusFailed);
    };
    button.addEventListener("click", () => {
      if (button.getAttribute("aria-disabled") === "true") return;
      button.setAttribute("aria-disabled", "true");
      tell(wrapper.dataset.giscusLoading);
      loadComments(wrapper, { onReady: shown, onError: failed });
    });
  }
</script>

<style>
  .giscus-wrapper {
    margin-top: var(--sb-space-7);
    padding-top: var(--sb-space-4);
    width: 100%;
    max-width: 100%;
  }

  .giscus-divider {
    border: none;
    border-top: 1px solid var(--sb-line);
    margin-bottom: var(--sb-space-5);
  }

  .giscus-title {
    font-size: var(--sb-text-h4);
    font-weight: 600;
    margin-bottom: var(--sb-space-4);
    color: var(--sb-ink-strong);
  }

  .giscus-ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sb-space-3) var(--sb-space-4);
  }

  .giscus-ask button {
    padding: var(--sb-space-2) var(--sb-space-4);
    border: 1px solid var(--sb-line-strong);
    border-radius: var(--sb-radius-pill);
    background: var(--sb-surface);
    color: var(--sb-ink-strong);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .giscus-ask button:hover {
    border-color: var(--sb-accent);
    color: var(--sb-accent);
  }

  .giscus-ask button[aria-disabled="true"] {
    opacity: 0.6;
    cursor: progress;
  }

  .giscus-title:focus {
    outline: none;
  }

  .giscus-ask p {
    margin: 0;
    color: var(--sb-ink-muted);
    font-size: var(--sb-text-sm);
  }

  /* Make Giscus iframe full width */
  .giscus-wrapper :global(.giscus),
  .giscus-wrapper :global(.giscus-frame) {
    width: 100%;
    min-width: 100%;
  }
</style>