---
// Giscus comments component for SmartBolig.net
// Only shows on article pages, not on index/splash pages

const pathname = Astro.url.pathname;
const locale = Astro.currentLocale || (pathname.startsWith('/en/') ? 'en' : 'da');
const isSplashPage = pathname.match(/^\/(da|en)\/?$/);
const isLegalPage = pathname.includes('/juridisk/');
const isIndexPage = pathname.endsWith('/index') || pathname.match(/\/(home-assistant|esp32|produkter|automationer|sikkerhed|ai|ai-cli|nyheder)\/?$/);
const isUtilityPage = pathname.includes('/404') || pathname.includes('/kontakt') || pathname.includes('/om-os');
const copy = {
  da: { title: "Kommentarer", show: "Vis kommentarer", note: "Kommentarerne hentes fra giscus.app og GitHub, når du trykker." },
  en: { title: "Comments", show: "Show comments", note: "The comments are fetched from giscus.app and GitHub when you press the button." },
}[locale === "en" ? "en" : "da"];

// Don't show comments on splash, legal, section index, or utility pages.
const showComments = !isSplashPage && !isLegalPage && !isIndexPage && !isUtilityPage;
---

{showComments && (
  <div class="giscus-wrapper" data-giscus-lang={locale} data-pagefind-ignore>
    <hr class="giscus-divider" />
    <h2 class="giscus-title">{copy.title}</h2>
    <div class="giscus-ask" data-giscus-ask>
      <button type="button" data-giscus-show>{copy.show}</button>
      <p>{copy.note}</p>
    </div>
  </div>
)}

<script>
  // Nothing is fetched from giscus.app until the visitor asks (src/lib/comments.mjs).
  import { loadComments } from "../lib/comments.mjs";

  const wrapper = document.querySelector<HTMLElement>(".giscus-wrapper");
  wrapper?.querySelector("[data-giscus-show]")?.addEventListener("click", () => {
    wrapper.querySelector("[data-giscus-ask]")?.remove();
    loadComments(wrapper);
  });
</script>

<style>
  .giscus-wrapper {
    margin-top: var(--sb-space-7);
    padding-top: var(--sb-space-4);
    width: 100%;
    max-width: 100%;
  }

  .giscus-divider {
    border: none;
    border-top: 1px solid var(--sb-line);
    margin-bottom: var(--sb-space-5);
  }

  .giscus-title {
    font-size: var(--sb-text-h4);
    font-weight: 600;
    margin-bottom: var(--sb-space-4);
    color: var(--sb-ink-strong);
  }

  .giscus-ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sb-space-3) var(--sb-space-4);
  }

  .giscus-ask button {
    padding: var(--sb-space-2) var(--sb-space-4);
    border: 1px solid var(--sb-line-strong);
    border-radius: var(--sb-radius-pill);
    background: var(--sb-surface);
    color: var(--sb-ink-strong);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .giscus-ask button:hover {
    border-color: var(--sb-accent);
    color: var(--sb-accent);
  }

  .giscus-ask p {
    margin: 0;
    color: var(--sb-ink-muted);
    font-size: var(--sb-text-sm);
  }

  /* Make Giscus iframe full width */
  .giscus-wrapper :global(.giscus),
  .giscus-wrapper :global(.giscus-frame) {
    width: 100%;
    min-width: 100%;
  }
</style>