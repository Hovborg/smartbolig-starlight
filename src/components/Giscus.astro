---
// Giscus comments component for SmartBolig.net
// Only shows on article pages, not on index/splash pages

const pathname = Astro.url.pathname;
const locale = Astro.currentLocale || (pathname.startsWith('/en/') ? 'en' : 'da');
const isSplashPage = pathname.match(/^\/(da|en)\/?$/);
const isLegalPage = pathname.includes('/juridisk/');
const isIndexPage = pathname.endsWith('/index') || pathname.match(/\/(home-assistant|esp32|produkter|automationer|sikkerhed|ai|ai-cli|nyheder)\/?$/);
const isUtilityPage = pathname.includes('/404') || pathname.includes('/kontakt') || pathname.includes('/om-os');
const title = locale === 'en' ? 'Comments' : 'Kommentarer';

// Don't show comments on splash, legal, section index, or utility pages.
const showComments = !isSplashPage && !isLegalPage && !isIndexPage && !isUtilityPage;
---

{showComments && (
  <div class="giscus-wrapper" data-giscus-lang={locale}>
    <hr class="giscus-divider" />
    <h2 class="giscus-title">{title}</h2>
  </div>
)}

<script>
  // The widget takes a theme name, so the client script is added here, after the
  // site theme (data-theme on <html>, set before paint) is known, and the theme is
  // pushed to the iframe with giscus' documented setConfig message on every change.
  const wrapper = document.querySelector<HTMLElement>(".giscus-wrapper");
  const GISCUS_ORIGIN = "https://giscus.app";

  const currentTheme = () => (document.documentElement.dataset.theme === "dark" ? "dark" : "light");

  const sendTheme = () => {
    const frame = document.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: currentTheme() } } }, GISCUS_ORIGIN);
  };

  if (wrapper) {
    const client = document.createElement("script");
    client.src = `${GISCUS_ORIGIN}/client.js`;
    client.async = true;
    client.crossOrigin = "anonymous";
    client.dataset.repo = "Hovborg/smartbolig-starlight";
    client.dataset.repoId = "R_kgDOQuqhoQ";
    client.dataset.category = "Comments";
    client.dataset.categoryId = "DIC_kwDOQuqhoc4C0naS";
    client.dataset.mapping = "pathname";
    client.dataset.strict = "1";
    client.dataset.reactionsEnabled = "1";
    client.dataset.emitMetadata = "0";
    client.dataset.inputPosition = "bottom";
    client.dataset.theme = currentTheme();
    client.dataset.lang = wrapper.dataset.giscusLang ?? "da";
    wrapper.append(client);

    new MutationObserver(sendTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    // The widget announces itself when ready; sync in case the theme changed while it loaded.
    window.addEventListener("message", (event) => {
      if (event.origin === GISCUS_ORIGIN && event.data && typeof event.data === "object" && "giscus" in event.data) {
        sendTheme();
      }
    });
  }
</script>

<style>
  .giscus-wrapper {
    margin-top: var(--sb-space-7);
    padding-top: var(--sb-space-4);
    width: 100%;
    max-width: 100%;
  }

  .giscus-divider {
    border: none;
    border-top: 1px solid var(--sb-line);
    margin-bottom: var(--sb-space-5);
  }

  .giscus-title {
    font-size: var(--sb-text-h4);
    font-weight: 600;
    margin-bottom: var(--sb-space-4);
    color: var(--sb-ink-strong);
  }

  /* Make Giscus iframe full width */
  .giscus-wrapper :global(.giscus),
  .giscus-wrapper :global(.giscus-frame) {
    width: 100% !important;
    min-width: 100% !important;
  }
</style>