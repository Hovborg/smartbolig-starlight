---
/**
 * Custom Footer Component for SmartBolig.net
 * Adds copyright notice and legal links
 */
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import SmartBoligAssistant from './SmartBoligAssistant.astro';

const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale || 'da';

// Translations
const translations = {
  da: {
    copyright: `© ${currentYear} SmartBolig.net - Alle rettigheder forbeholdes`,
    terms: 'Brugsvilkår',
    privacy: 'Privatlivspolitik',
    affiliate: 'Affiliate Disclosure',
    noReproduction: 'Indhold må ikke kopieres uden skriftlig tilladelse.',
    legalNav: 'Juridiske links',
  },
  en: {
    copyright: `© ${currentYear} SmartBolig.net - All rights reserved`,
    terms: 'Terms of Use',
    privacy: 'Privacy Policy',
    affiliate: 'Affiliate Disclosure',
    noReproduction: 'Content may not be copied without written permission.',
    legalNav: 'Legal links',
  },
};

const t = translations[locale as keyof typeof translations] || translations.da;
const basePath = locale === 'en' ? '/en' : '/da';
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />

  <!-- Copyright and Legal Section -->
  <div class="copyright-section">
    <div class="copyright-notice">
      <p class="copyright-text">{t.copyright}</p>
      <p class="no-reproduction">{t.noReproduction}</p>
    </div>
    <nav class="legal-links" aria-label={t.legalNav}>
      <a href={`${basePath}/juridisk/brugsvilkaar/`}>{t.terms}</a>
      <span class="separator">|</span>
      <a href={`${basePath}/juridisk/privatlivspolitik/`}>{t.privacy}</a>
      <span class="separator">|</span>
      <a href={`${basePath}/juridisk/affiliate-disclosure/`}>{t.affiliate}</a>
    </nav>
  </div>
</footer>

<SmartBoligAssistant locale={locale} />

<style>
  @layer starlight.core {
    footer {
      flex-direction: column;
      gap: var(--sb-space-5);
    }
    .meta {
      gap: var(--sb-space-3) var(--sb-space-7);
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: var(--sb-space-7);
      font-size: var(--sb-text-sm);
      color: var(--sb-ink-subtle);
    }
    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }
  }

  .copyright-section {
    margin-top: var(--sb-space-6);
    padding-top: var(--sb-space-5);
    border-top: 1px solid var(--sb-line);
    text-align: center;
  }

  .copyright-notice {
    margin-bottom: var(--sb-space-4);
  }

  .copyright-text {
    font-size: var(--sb-text-sm);
    font-weight: 600;
    color: var(--sb-ink-muted);
    margin: 0;
  }

  .no-reproduction {
    font-size: var(--sb-text-xs);
    color: var(--sb-ink-subtle);
    margin: var(--sb-space-2) 0 0 0;
  }

  .legal-links {
    display: flex;
    justify-content: center;
    gap: var(--sb-space-2);
    flex-wrap: wrap;
    font-size: var(--sb-text-xs);
  }

  .legal-links a {
    display: inline-block;
    padding-block: var(--sb-space-3);
    padding-inline: var(--sb-space-2);
    color: var(--sb-ink-subtle);
    text-decoration: none;
  }

  .legal-links a:hover {
    color: var(--sb-accent);
    text-decoration: underline;
  }

  .legal-links a:focus-visible {
    outline: 2px solid var(--sb-accent);
    outline-offset: 2px;
    border-radius: var(--sb-radius-sm);
  }

  .separator {
    color: var(--sb-line-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .legal-links a {
      transition: color var(--sb-dur) var(--sb-ease);
    }
  }
</style>