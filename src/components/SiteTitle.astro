---
// Logo: the house mark plus the name as live text, so it is sharp at any size
// and follows the light and dark theme through the colour tokens.
const { siteTitleHref } = Astro.locals.starlightRoute;
const label = Astro.currentLocale === "en" ? "SmartBolig.net, front page" : "SmartBolig.net, forside";
---

<a href={siteTitleHref} class="sb-logo" aria-label={label}>
  <svg class="sb-logo__mark" viewBox="0 0 32 32" width="34" height="34" aria-hidden="true">
    <rect class="tile" width="32" height="32" rx="9.5"></rect>
    <path class="line" d="M7.5 15.4 16 8l8.5 7.4"></path>
    <path class="line" d="M10 14.2V22a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-7.8"></path>
    <circle class="dot" cx="16" cy="18.7" r="2.1"></circle>
  </svg>
  <span class="sb-logo__word" translate="no">Smart<span class="bolig">Bolig</span><span class="tld">.net</span></span>
</a>

<style>
  .sb-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--sb-ink-strong);
    text-decoration: none;
    white-space: nowrap;
  }
  .sb-logo__mark {
    flex: none;
    transition: transform var(--sb-dur) var(--sb-ease);
  }
  .sb-logo:hover .sb-logo__mark {
    transform: rotate(-6deg) scale(1.05);
  }
  .tile {
    fill: var(--sb-accent);
  }
  .line {
    fill: none;
    stroke: var(--sb-on-accent);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dot {
    fill: var(--sb-on-accent);
  }
  .sb-logo__word {
    font-family: var(--sb-font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .bolig {
    color: var(--sb-accent);
  }
  .tld {
    color: var(--sb-ink-subtle);
    font-size: 0.72em;
    font-weight: 500;
    letter-spacing: 0;
  }
  @media (max-width: 26rem) {
    .tld {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sb-logo:hover .sb-logo__mark {
      transform: none;
    }
  }
</style>
