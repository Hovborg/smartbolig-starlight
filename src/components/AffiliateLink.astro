---
/**
 * Affiliate Link Component for SmartBolig.net
 * Wraps product links in affiliate tracking URLs
 *
 * Usage:
 * <AffiliateLink store="proshop" url="https://www.proshop.dk/Smart-Home/..." text="Køb hos Proshop" />
 */

import { affiliateMerchants, buildAffiliateUrl, type AffiliateStore } from '../lib/affiliate';

interface Props {
  store: AffiliateStore;
  url: string;
  text?: string;
  price?: string;
  class?: string;
}

const { store, url, text, price, class: className } = Astro.props;

const config = affiliateMerchants[store];
const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'da';
const affiliateUrl = buildAffiliateUrl(store, url);
const displayText = text || `${lang === 'en' ? 'Buy at' : 'Køb hos'} ${config.name}`;
---

<a
  href={affiliateUrl}
  target="_blank"
  rel="noopener sponsored nofollow"
  class:list={['affiliate-link', `affiliate-${store}`, className]}
>
  <span class="affiliate-icon" aria-hidden="true">{config.icon}</span>
  <span class="affiliate-text">{displayText}</span>
  <span class="affiliate-label">{lang === 'en' ? 'Ad link' : 'Reklamelink'}</span>
  {price && <span class="affiliate-price">{price}</span>}
  <span class="sr-only">{lang === 'en' ? '(opens in a new tab)' : '(åbner i ny fane)'}</span>
</a>

<style>
  /* Starlight colours every link in page content. The first selector outranks
     that rule; the second covers use outside page content. Each merchant sets
     a text colour and a soft background from the same hue. */
  .affiliate-link {
    --affiliate-ink: var(--sb-accent-strong);
    --affiliate-bg: var(--sb-accent-soft);
  }

  .affiliate-proshop {
    --affiliate-ink: var(--sb-sky);
    --affiliate-bg: var(--sb-sky-soft);
  }

  .affiliate-specialkamera {
    --affiliate-ink: var(--sb-warm);
    --affiliate-bg: var(--sb-warm-soft);
  }

  :global(.sl-markdown-content) .affiliate-link,
  .affiliate-link {
    display: inline-flex;
    flex-wrap: wrap;
    max-width: 100%;
    align-items: center;
    gap: var(--sb-space-1) var(--sb-space-2);
    padding: var(--sb-space-2) var(--sb-space-3);
    border: 1px solid color-mix(in srgb, var(--affiliate-ink) 28%, transparent);
    border-radius: var(--sb-radius-md);
    background: var(--affiliate-bg);
    color: var(--affiliate-ink);
    font-size: var(--sb-text-sm);
    font-weight: 650;
    line-height: 1.35;
    text-decoration: none;
  }

  .affiliate-link:hover {
    border-color: var(--affiliate-ink);
    box-shadow: var(--sb-shadow-sm);
  }

  .affiliate-link:focus-visible {
    outline: 3px solid var(--sb-accent);
    outline-offset: 2px;
  }

  .affiliate-icon {
    font-size: var(--sb-text-base);
  }

  .affiliate-label {
    color: var(--sb-ink-muted);
    font-size: var(--sb-text-xs);
    font-weight: 500;
  }

  .affiliate-price {
    padding: 0.1rem var(--sb-space-2);
    border-radius: var(--sb-radius-sm);
    background: var(--sb-surface);
    color: var(--sb-ink-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .affiliate-link {
      transition:
        border-color var(--sb-dur) var(--sb-ease),
        box-shadow var(--sb-dur) var(--sb-ease);
    }
  }
</style>
