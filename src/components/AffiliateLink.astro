---
/**
 * Affiliate Link Component for SmartBolig.net
 * Wraps product links in affiliate tracking URLs
 *
 * Usage:
 * <AffiliateLink store="proshop" url="https://www.proshop.dk/Smart-Home/..." text="Køb hos Proshop" />
 */

import { affiliateMerchants, buildAffiliateUrl, type AffiliateStore } from '../lib/affiliate';

interface Props {
  store: AffiliateStore;
  url: string;
  text?: string;
  price?: string;
  class?: string;
}

const { store, url, text, price, class: className } = Astro.props;

const config = affiliateMerchants[store];
const lang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'da';
const affiliateUrl = buildAffiliateUrl(store, url);
const displayText = text || `${lang === 'en' ? 'Buy at' : 'Køb hos'} ${config.name}`;
---

<a
  href={affiliateUrl}
  target="_blank"
  rel="noopener sponsored nofollow"
  class:list={['affiliate-link', `affiliate-${store}`, className]}
>
  <span class="affiliate-icon" aria-hidden="true">{config.icon}</span>
  <span class="affiliate-text">{displayText}</span>
  <span class="affiliate-label">{lang === 'en' ? 'Ad link' : 'Reklamelink'}</span>
  {price && <span class="affiliate-price">{price}</span>}
  <span class="sr-only">{lang === 'en' ? '(opens in a new tab)' : '(åbner i ny fane)'}</span>
</a>

<style>
  .affiliate-link {
    display: inline-flex;
    flex-wrap: wrap;
    max-width: 100%;
    align-items: center;
    gap: var(--sb-space-2);
    padding: var(--sb-space-2) var(--sb-space-4);
    background: var(--sb-accent);
    color: var(--sb-on-accent);
    text-decoration: none;
    border-radius: var(--sb-radius-sm);
    font-weight: 500;
    font-size: var(--sb-text-sm);
    box-shadow: var(--sb-shadow-sm);
  }

  .affiliate-link:hover {
    background: var(--sb-accent-strong);
    box-shadow: var(--sb-shadow-md);
  }

  .affiliate-link:focus-visible {
    outline: 2px solid var(--sb-accent);
    outline-offset: 2px;
  }

  .affiliate-proshop,
  .affiliate-proshop:hover {
    background: var(--sb-sky);
  }

  .affiliate-specialkamera,
  .affiliate-specialkamera:hover {
    background: var(--sb-warm);
  }

  .affiliate-icon {
    font-size: var(--sb-text-lg);
  }

  .affiliate-label {
    font-size: var(--sb-text-xs);
    font-weight: 400;
  }

  .affiliate-price {
    background: color-mix(in srgb, var(--sb-on-accent) 20%, transparent);
    padding: 0.2rem var(--sb-space-2);
    border-radius: var(--sb-radius-sm);
    font-size: var(--sb-text-sm);
  }

  @media (prefers-reduced-motion: no-preference) {
    .affiliate-link {
      transition:
        background-color var(--sb-dur) var(--sb-ease),
        box-shadow var(--sb-dur) var(--sb-ease),
        transform var(--sb-dur) var(--sb-ease);
    }

    .affiliate-link:hover {
      transform: translateY(-1px);
    }
  }
</style>