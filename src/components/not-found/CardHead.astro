---
import type { NotFoundCopy } from "../../lib/not-found-copy";

interface Props {
  t: NotFoundCopy;
}

const { t } = Astro.props;
---

<header class="card-head">
  <span class="card-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 11.4 12 4l9 7.4"></path>
      <path d="M5.6 10.3V20h12.8v-9.7"></path>
      <path d="m9.8 13.8 4.4 4.4m0-4.4-4.4 4.4"></path>
    </svg>
  </span>
  <span class="card-titles">
    <strong class="entity-id" id="nf-entity">{t.entityId}</strong>
    <span class="card-hint" id="nf-card-hint">{t.cardHint}</span>
  </span>
</header>

<style>
  .card-head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    border-bottom: 1px solid var(--sb-line);
  }

  .card-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--sb-radius-pill);
    border: 1px solid color-mix(in srgb, var(--sb-warm) 35%, transparent);
    background: color-mix(in srgb, var(--sb-warm) 12%, transparent);
    color: var(--sb-warm);
  }

  .card-icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  :global(.card.is-restarting) .card-icon {
    color: var(--sb-accent);
    border-color: var(--sb-line-strong);
    background: color-mix(in srgb, var(--sb-accent) 12%, transparent);
  }

  .card-titles {
    min-width: 0;
  }

  .entity-id {
    display: block;
    font-family: var(--sb-font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .card-hint {
    display: block;
    margin-top: 0.2rem;
    color: var(--sb-ink-muted);
    font-size: var(--sb-text-xs);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card-icon {
      transition:
        color var(--sb-dur) var(--sb-ease),
        border-color var(--sb-dur) var(--sb-ease),
        background var(--sb-dur) var(--sb-ease);
    }

    :global(.card.is-restarting) .card-icon {
      animation: spin 1.1s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
  }
</style>
