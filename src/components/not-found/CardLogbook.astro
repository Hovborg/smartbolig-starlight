---
import type { NotFoundCopy } from "../../lib/not-found-copy";

interface Props {
  t: NotFoundCopy;
}

const { t } = Astro.props;
---

<div class="logbook">
  <h2 id="nf-log-title">{t.logTitle}</h2>
  <ol class="log-list" id="nf-log">
    {t.logLines.map((line) => (
      <li>
        <span class="log-time">--:--:--</span>
        <span class="log-text">{line}</span>
      </li>
    ))}
    {t.restartLines.map(() => (
      <li hidden class="fresh">
        <span class="log-time">--:--:--</span>
        <span class="log-text"></span>
      </li>
    ))}
  </ol>
  <button type="button" class="restart" id="nf-restart">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
      <path d="M21 3v6h-6"></path>
    </svg>
    <span id="nf-restart-label">{t.restartLabel}</span>
  </button>
</div>

<style>
  .logbook {
    padding: 0.9rem 1.15rem 1.05rem;
    border-top: 1px solid var(--sb-line);
    background: var(--sb-bg-subtle);
  }

  .logbook h2 {
    margin: 0 0 0.6rem;
    color: var(--sb-ink-muted);
    font-family: var(--sb-font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .log-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    font-family: var(--sb-font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .log-list li {
    display: flex;
    gap: 0.7rem;
  }

  .log-list li[hidden] {
    display: none;
  }

  .log-time {
    flex: none;
    color: var(--sb-ink-subtle);
    font-variant-numeric: tabular-nums;
  }

  .log-text {
    color: var(--sb-ink-muted);
    overflow-wrap: anywhere;
  }

  .log-list li.fresh .log-text {
    color: var(--sb-warm);
  }

  .restart {
    margin-top: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--sb-line);
    border-radius: var(--sb-radius-pill);
    background: transparent;
    color: var(--sb-ink-muted);
    font-family: var(--sb-font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .restart:hover:not(:disabled),
  .restart:focus-visible {
    border-color: var(--sb-line-strong);
    color: var(--sb-accent);
  }

  .restart:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .restart svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .restart {
      transition:
        border-color var(--sb-dur-fast) var(--sb-ease),
        color var(--sb-dur-fast) var(--sb-ease);
    }

    :global(.card.is-restarting) .restart svg {
      animation: spin 1.1s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
  }
</style>
