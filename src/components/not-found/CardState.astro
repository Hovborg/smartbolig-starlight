---
import type { NotFoundCopy } from "../../lib/not-found-copy";

interface Props {
  t: NotFoundCopy;
}

const { t } = Astro.props;

// A 24-slot state history: available for most of the day, then the drop-out
// that produced this 404. Rendered server-side so the scoped styles apply.
const historySlots = Array.from({ length: 24 }, (_, i) => i >= 21);
---

<div class="card-state">
  <span class="state-value" id="nf-state">{t.stateLabel}</span>
  <span class="state-code">HTTP 404</span>
</div>

<div class="history">
  <p class="history-label" id="nf-history-label">{t.historyLabel}</p>
  <div class="history-bar" role="img" aria-label="Home Assistant state history">
    {historySlots.map((down) => <span class={down ? "down" : undefined}></span>)}
  </div>
</div>

<style>
  .card-state {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1rem;
    padding: 1.25rem 1.15rem 0.5rem;
  }

  .state-value {
    font-family: var(--sb-font-mono);
    font-size: clamp(1.6rem, 5.5vw, 2.3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sb-warm);
    text-transform: uppercase;
  }

  :global(.card.is-restarting) .state-value {
    color: var(--sb-accent);
  }

  .state-code {
    font-family: var(--sb-font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--sb-ink-muted);
    border: 1px solid var(--sb-line);
    border-radius: var(--sb-radius-pill);
    padding: 0.25rem 0.6rem;
  }

  .history {
    padding: 0.35rem 1.15rem 1.1rem;
  }

  .history-label {
    margin: 0 0 0.5rem;
    color: var(--sb-ink-muted);
    font-family: var(--sb-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .history-bar {
    display: flex;
    gap: 2px;
    height: 1.6rem;
  }

  .history-bar span {
    flex: 1;
    border-radius: calc(var(--sb-radius-sm) / 4);
    background: var(--sb-accent-vivid);
    opacity: 0.55;
  }

  .history-bar span.down {
    background:
      repeating-linear-gradient(135deg, var(--sb-warm-vivid) 0 3px, transparent 3px 6px),
      color-mix(in srgb, var(--sb-warm-vivid) 22%, transparent);
    opacity: 1;
  }

  :global(.card.is-restarting) .history-bar span {
    background: var(--sb-accent-vivid);
    opacity: 0.28;
  }

  @media (prefers-reduced-motion: no-preference) {
    .state-value {
      transition: color var(--sb-dur) var(--sb-ease);
    }

    .history-bar span.down {
      animation: flicker 1.8s steps(2, end) infinite;
    }

    :global(.card.is-restarting) .history-bar span {
      animation: sweep 1.1s ease-in-out infinite;
    }

    @keyframes flicker {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.55;
      }
    }

    @keyframes sweep {
      0%,
      100% {
        opacity: 0.18;
      }
      50% {
        opacity: 0.6;
      }
    }
  }
</style>
