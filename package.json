{
  "name": "smartbolig-starlight",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "house:posters": "node scripts/house-posters.mjs",
    "brand:build": "node scripts/brand-assets.mjs",
    "images:news-thumbs": "node scripts/ai-news-thumbs.mjs",
    "build": "node scripts/ai-news-thumbs.mjs && astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "ai-news:draft": "node scripts/ai-news-publish.mjs --write",
    "ai-news:pending-images": "node scripts/ai-news-pending-images.mjs",
    "ai-news:render-image": "node scripts/ai-news-render-image.mjs",
    "ai-news:source-health": "node scripts/ai-news-source-health.mjs",
    "ai-news:test": "node --test scripts/ai-news-*.test.mjs",
    "ai-news:quality": "node scripts/ai-news-quality.mjs",
    "ai-news:quality:changed": "node scripts/ai-news-quality-changed.mjs",
    "ai-news:validate": "node scripts/ai-news-validate.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "site:test": "node --test scripts/chat-*.test.mjs scripts/site-*.test.mjs scripts/rss.test.mjs scripts/sitemap-lastmod.test.mjs scripts/security-audit.test.mjs",
    "seo:validate": "node scripts/seo-validate.mjs",
    "worker:build": "wrangler pages functions build functions --outdir .worker --project-directory ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/starlight": "^0.41.7",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "astro": "^7.4.7",
    "github-slugger": "2.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "three": "0.187.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261109.1": true,
    "sharp@0.34.5": true
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fontkitten": "1.0.3",
    "wrangler": "4.159.0"
  }
}
