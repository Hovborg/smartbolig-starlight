{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smartbolig-starlight",
  "main": "./.worker/index.js",
  "compatibility_date": "2026-04-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "smartbolig.net/*",
      "zone_name": "smartbolig.net"
    },
    {
      "pattern": "www.smartbolig.net/*",
      "zone_name": "smartbolig.net"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ai_search": [
    {
      "binding": "SMARTBOLIG_SEARCH",
      "instance_name": "smartbolig-ai-search",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "2026073101",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
